---
interface AboutProps {
  bio: string;
  birthDate?: string;
  availabilityValue?: number;
  cvUrl?: string;
  linkedinUrl?: string;
  email?: string;
  github?: string;
}

const { bio, birthDate, availabilityValue = 0, cvUrl, linkedinUrl, email, github } = Astro.props;

// Compute age at build time
let age: number | null = null;
if (birthDate) {
  const birth = new Date(birthDate);
  if (!isNaN(birth.getTime())) {
    const today = new Date();
    let calculatedAge = today.getFullYear() - birth.getFullYear();
    const m = today.getMonth() - birth.getMonth();
    if (m < 0 || (m === 0 && today.getDate() < birth.getDate())) calculatedAge--;
    age = calculatedAge;
  }
}

const availability = Math.max(0, Math.min(100, availabilityValue));
---

<section class="recruiter-section" id="about">
  <div class="recruiter-container">
    <h2 class="recruiter-section-title">Sobre mí</h2>

    <p class="text-base text-white/70 leading-relaxed mb-8 max-w-2xl">
      {bio}
    </p>

    <div class="flex flex-wrap gap-6 mb-8">
      {age !== null && (
        <div class="bg-white/[0.04] border border-white/10 rounded-xl px-5 py-4">
          <span class="block text-xs text-white/40 mb-1">Edad</span>
          <span class="text-2xl font-bold text-white">{age}</span>
        </div>
      )}

      <div class="bg-white/[0.04] border border-white/10 rounded-xl px-5 py-4 min-w-[200px]">
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs text-white/40">Disponibilidad</span>
          <span class="text-sm font-semibold text-recruiter-accent-light">{availability}%</span>
        </div>
        <div class="h-2 bg-white/10 rounded-full overflow-hidden">
          <div
            class="h-full bg-recruiter-accent rounded-full transition-[width] duration-700 ease-out"
            style={`width: ${availability}%`}
          ></div>
        </div>
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-3">
      {cvUrl && (
        <a
          href={cvUrl}
          download
          class="inline-flex items-center justify-center bg-recruiter-accent text-white text-sm font-semibold px-6 py-3 rounded-xl hover:bg-recruiter-accent-light transition-all duration-150 active:scale-[0.98] shadow-md shadow-blue-500/10"
        >
          Descargar CV
        </a>
      )}

      <div class="flex items-center gap-3">
        {email && (
          <a
            href={`mailto:${email}`}
            class="p-3 bg-white/[0.04] border border-white/10 hover:border-recruiter-accent/60 hover:bg-white/[0.08] rounded-xl text-white hover:text-recruiter-accent-light transition-all shadow-sm hover:shadow-[0_0_12px_rgba(0,102,255,0.15)] flex items-center justify-center shrink-0 cursor-pointer"
            title="Email"
            aria-label="Email"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="16" x="2" y="4" rx="2"/>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
          </a>
        )}

        {linkedinUrl && (
          <a
            href={linkedinUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="p-3 bg-white/[0.04] border border-white/10 hover:border-recruiter-accent/60 hover:bg-white/[0.08] rounded-xl text-white hover:text-recruiter-accent-light transition-all shadow-sm hover:shadow-[0_0_12px_rgba(0,102,255,0.15)] flex items-center justify-center shrink-0 cursor-pointer"
            title="LinkedIn"
            aria-label="LinkedIn"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
              <rect width="4" height="12" x="2" y="9"/>
              <circle cx="4" cy="4" r="2"/>
            </svg>
          </a>
        )}

        {github && (
          <a
            href={github}
            target="_blank"
            rel="noopener noreferrer"
            class="p-3 bg-white/[0.04] border border-white/10 hover:border-recruiter-accent/60 hover:bg-white/[0.08] rounded-xl text-white hover:text-recruiter-accent-light transition-all shadow-sm hover:shadow-[0_0_12px_rgba(0,102,255,0.15)] flex items-center justify-center shrink-0 cursor-pointer"
            title="GitHub"
            aria-label="GitHub"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
              <path d="M9 18c-4.51 2-5-2-7-2"/>
            </svg>
          </a>
        )}
      </div>
    </div>
  </div>
</section>
