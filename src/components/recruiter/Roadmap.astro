---
import type { Ambition } from '../../types';

interface TimeframeMeta {
  label: string;
  timeframe: string;
}

interface Props {
  ambitions: Ambition[];
  roadmapLabels?: {
    short: TimeframeMeta;
    mid: TimeframeMeta;
    long: TimeframeMeta;
  };
}

const {
  ambitions = [],
  roadmapLabels = {
    short: { label: 'CORTO PLAZO', timeframe: '6-12 meses' },
    mid: { label: 'MEDIO PLAZO', timeframe: '1-3 años' },
    long: { label: 'LARGO PLAZO', timeframe: '3-5 años' },
  },
} = Astro.props;

// Group ambitions by section
const shortAmbitions = ambitions.filter((a) => a.section === 'short');
const midAmbitions = ambitions.filter((a) => a.section === 'mid');
const longAmbitions = ambitions.filter((a) => a.section === 'long');

const sections = [
  { key: 'short', meta: roadmapLabels.short, list: shortAmbitions },
  { key: 'mid', meta: roadmapLabels.mid, list: midAmbitions },
  { key: 'long', meta: roadmapLabels.long, list: longAmbitions },
];
---

<section class="recruiter-section" id="ambitions">
  <div class="recruiter-container">
    <h2 class="recruiter-section-title">Metas y Objetivos</h2>

    <div class="overflow-x-auto border border-white/10 rounded-xl bg-white/[0.02] backdrop-blur-md shadow-xl">
      <table class="w-full text-left border-collapse min-w-[600px]">
        <thead>
          <tr class="border-b border-white/10 text-xs text-recruiter-accent-light uppercase tracking-widest bg-white/[0.01]">
            <th class="py-4 px-6 font-bold w-1/4">Plazo</th>
            <th class="py-4 px-6 font-bold w-1/6">Estado</th>
            <th class="py-4 px-6 font-bold">Meta u Objetivo</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-white/[0.05]">
          {sections.flatMap(({ key, meta, list }) => 
            list.map((item) => {
              const badgeClass = 
                key === 'short' ? 'bg-sky-500/10 text-sky-400 border border-sky-500/20' :
                key === 'mid' ? 'bg-blue-500/10 text-blue-400 border border-blue-500/20' :
                'bg-indigo-500/10 text-indigo-400 border border-indigo-500/20';
              
              return (
                <tr class="hover:bg-white/[0.03] transition-colors duration-150">
                  <td class="py-4 px-6 align-middle">
                    <div class="flex flex-col">
                      <span class={`text-[10px] font-bold tracking-wider uppercase px-2.5 py-1 rounded-full border inline-block w-fit ${badgeClass}`}>
                        {meta.label}
                      </span>
                      <span class="text-[11px] text-white/40 mt-1 block pl-1">
                        {meta.timeframe}
                      </span>
                    </div>
                  </td>
                  <td class="py-4 px-6 align-middle">
                    {item.completed ? (
                      <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-400 bg-emerald-400/10 border border-emerald-400/20 px-2.5 py-1 rounded-full">
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                        </svg>
                        Completado
                      </span>
                    ) : (
                      <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-white/40 bg-white/[0.03] border border-white/10 px-2.5 py-1 rounded-full">
                        <span class="w-2 h-2 rounded-full bg-white/20 animate-pulse"></span>
                        En progreso
                      </span>
                    )}
                  </td>
                  <td class="py-4 px-6 align-middle">
                    <span class={`text-sm leading-relaxed ${item.completed ? 'text-white/35 line-through decoration-recruiter-accent/35' : 'text-white/80 font-medium'}`}>
                      {item.text}
                    </span>
                  </td>
                </tr>
              );
            })
          )}
          {ambitions.length === 0 && (
            <tr>
              <td colspan="3" class="py-8 px-6 text-center text-sm text-white/30 italic">
                Sin metas ni objetivos definidos actualmente.
              </td>
            </tr>
          )}
        </tbody>
      </table>
    </div>
  </div>
</section>
