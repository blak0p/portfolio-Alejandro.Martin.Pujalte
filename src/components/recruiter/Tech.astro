---
interface TechItem {
  name: string;
  version?: string;
  usageLevel: number;
}

interface TechProps {
  tools: TechItem[];
}

const { tools } = Astro.props;
---

<section class="recruiter-section" id="tech">
  <div class="recruiter-container">
    <h2 class="recruiter-section-title">Tecnologías</h2>

    {tools.length === 0 ? (
      <p class="text-sm text-white/40">Sin tecnologías registradas.</p>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {tools.map((tool) => {
          const level = Math.max(0, Math.min(100, tool.usageLevel));
          return (
            <div class="bg-white/[0.03] border border-white/10 rounded-xl p-4 flex flex-col gap-2 transition-all duration-200 hover:border-recruiter-accent/40 hover:shadow-[0_0_12px_rgba(202,138,4,0.08)]">
              <div class="flex justify-between items-center">
                <span class="text-base font-semibold text-white">{tool.name}</span>
                {tool.version && (
                  <span class="text-xs text-white/40">{tool.version}</span>
                )}
              </div>
              <div class="h-1.5 bg-white/10 rounded-full overflow-hidden">
                <div
                  class="h-full bg-gradient-to-r from-recruiter-accent-dark to-recruiter-accent-light rounded-full transition-[width] duration-700 ease-out"
                  style={`width: ${level}%`}
                ></div>
              </div>
            </div>
          );
        })}
      </div>
    )}
  </div>
</section>
