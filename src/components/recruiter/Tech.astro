---
interface TechItem {
  name: string;
  version?: string;
  group?: string;
}

interface TechProps {
  tools: TechItem[] | string[];
}

const { tools } = Astro.props as TechProps;

const items: TechItem[] = Array.isArray(tools)
  ? tools.map((t) => (typeof t === 'string' ? { name: t, group: 'Otros' } : t))
  : [];

const groups: { name: string; items: TechItem[] }[] = [];
for (const t of items) {
  const g = t.group || 'Otros';
  let entry = groups.find((x) => x.name === g);
  if (!entry) groups.push((entry = { name: g, items: [] }));
  entry.items.push(t);
}
---

<section class="recruiter-section" id="tech">
  <div class="recruiter-container">
    <h2 class="recruiter-section-title">Stack</h2>

    {groups.length === 0 ? (
      <p class="text-sm text-white/40">Sin tecnologías registradas.</p>
    ) : (
      <dl class="grid grid-cols-1 sm:grid-cols-[140px_1fr] gap-x-6 gap-y-3">
        {groups.map((g) => (
          <>
            <dt class="text-xs uppercase tracking-wider text-white/40 pt-1">{g.name}</dt>
            <dd class="flex flex-wrap gap-2 m-0">
              {g.items.map((tool) => (
                <span class="bg-white/[0.06] border border-white/10 text-white/80 text-sm px-3 py-1.5 rounded-md">
                  {tool.name}{tool.version && <span class="text-white/40 font-mono ml-1.5">{tool.version}</span>}
                </span>
              ))}
            </dd>
          </>
        ))}
      </dl>
    )}
  </div>
</section>
