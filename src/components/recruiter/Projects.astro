---
interface RecruiterProject {
  name: string;
  photo?: string;
  description?: string;
  stack: string[];
  repo?: string;
}

interface ProjectsProps {
  projects: RecruiterProject[];
}

const { projects } = Astro.props;
---

<section class="recruiter-section" id="projects">
  <div class="recruiter-container">
    <h2 class="recruiter-section-title">Proyectos</h2>

    {projects.length === 0 ? (
      <p class="text-sm text-white/40">Sin proyectos para mostrar.</p>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {projects.map((project) => (
          <article class="group bg-white/[0.03] border border-white/10 rounded-xl overflow-hidden transition-all duration-200 hover:border-recruiter-accent/40 hover:shadow-[0_0_24px_rgba(202,138,4,0.1)] hover:scale-[1.015]">
            {project.photo && (
              <div class="relative aspect-[16/9] overflow-hidden">
                <img
                  src={project.photo}
                  alt={project.name}
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-[#0d0d0d] via-transparent to-transparent pointer-events-none"></div>
              </div>
            )}

            <div class="p-5 flex flex-col gap-3">
              <div class="flex items-start justify-between gap-3">
                <h3 class="text-lg font-semibold text-white leading-tight">
                  {project.name}
                </h3>
                {project.repo && (
                  <a
                    href={project.repo}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-xs font-medium text-recruiter-accent-light hover:text-recruiter-accent transition-colors shrink-0 mt-1"
                    aria-label={`Repositorio de ${project.name}`}
                  >
                    Repo →
                  </a>
                )}
              </div>

              {project.description && (
                <p class="text-sm text-white/60 leading-relaxed">
                  {project.description}
                </p>
              )}

              {project.stack.length > 0 && (
                <div class="flex flex-wrap gap-1.5 mt-1">
                  {project.stack.map((tech) => (
                    <span class="text-xs bg-white/[0.06] text-white/50 px-2.5 py-1 rounded-md">
                      {tech}
                    </span>
                  ))}
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
    )}
  </div>
</section>
