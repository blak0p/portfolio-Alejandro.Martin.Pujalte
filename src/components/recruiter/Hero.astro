---
interface HeroProps {
  name: string;
  handle: string;
  status?: string;
  photo?: string;
  email?: string;
  linkedin?: string;
  github?: string;

  // Merged About props
  bio: string;
  birthDate?: string;
  availabilityValue?: number;
  cvUrl?: string;
}

const {
  name,
  handle,
  photo = '/profile.jpg',
  email,
  linkedin,
  github,
  bio,
  birthDate,
  availabilityValue = 0,
  cvUrl
} = Astro.props;

// Compute age at build time
let age: number | null = null;
if (birthDate) {
  const birth = new Date(birthDate);
  if (!isNaN(birth.getTime())) {
    const today = new Date();
    let calculatedAge = today.getFullYear() - birth.getFullYear();
    const m = today.getMonth() - birth.getMonth();
    if (m < 0 || (m === 0 && today.getDate() < birth.getDate())) calculatedAge--;
    age = calculatedAge;
  }
}

const availability = Math.max(0, Math.min(100, availabilityValue));
---

<section class="relative w-full min-h-[85vh] flex items-center justify-center overflow-hidden recruiter-hero px-4 py-16">
  <!-- Animated warm gradient backdrop -->
  <div class="absolute inset-0 -z-10 recruiter-gradient-bg" aria-hidden="true"></div>

  <!-- Glassmorphic Card Container (Unified Hero + About) -->
  <div class="relative z-10 flex flex-col md:flex-row items-center md:items-stretch justify-center gap-10 p-8 sm:p-12 rounded-3xl bg-white/[0.02] border border-white/10 backdrop-blur-xl max-w-4xl w-full shadow-[0_20px_50px_rgba(0,0,0,0.4)] hover:border-recruiter-accent/30 transition-all duration-500 recruiter-section visible">
    
    <!-- Left Column: Photo & Name & Handle & Contact buttons -->
    <div class="flex flex-col items-center justify-between text-center md:text-left gap-6 shrink-0 md:w-56">
      <div class="flex flex-col items-center gap-4 w-full">
        <div class="w-40 h-40 sm:w-44 sm:h-44 rounded-3xl overflow-hidden border border-white/20 shadow-[0_0_40px_rgba(0,102,255,0.25)] animate-float transition-all duration-300 hover:scale-105">
          <img
            src={photo}
            alt={name}
            class="w-full h-full object-cover"
            loading="eager"
            decoding="async"
          />
        </div>

        <div class="flex flex-col items-center gap-2 hero-text-reveal">
          <h1 class="text-3xl sm:text-4xl font-extrabold text-white leading-tight tracking-tight text-center">
            {name.replace('\n', ' ')}
          </h1>
          <p class="text-sm text-recruiter-accent-light/90 font-semibold tracking-wider uppercase font-mono text-center">
            {handle}
          </p>
        </div>
      </div>

      <!-- Action / Contact Buttons -->
      <div class="flex flex-col w-full gap-3 mt-4">
        {cvUrl && (
          <a
            href={cvUrl}
            download
            class="inline-flex items-center justify-center bg-recruiter-accent text-white text-sm font-semibold py-3 px-4 rounded-2xl hover:bg-recruiter-accent-light hover:shadow-[0_0_20px_rgba(0,102,255,0.3)] transition-all duration-200 active:scale-[0.98] shadow-md shadow-blue-500/10 cursor-pointer text-center w-full"
          >
            Descargar CV
          </a>
        )}

        <div class="flex items-center justify-center gap-2.5 w-full">
          {email && (
            <a
              href={`mailto:${email}`}
              class="p-3 bg-white/[0.02] border border-white/10 hover:border-recruiter-accent/60 hover:bg-white/[0.06] rounded-2xl text-white hover:text-recruiter-accent-light transition-all shadow-sm hover:shadow-[0_0_15px_rgba(0,102,255,0.2)] flex items-center justify-center shrink-0 cursor-pointer flex-1"
              title="Email"
              aria-label="Email"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="20" height="16" x="2" y="4" rx="2"/>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
              </svg>
            </a>
          )}

          {linkedin && (
            <a
              href={linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="p-3 bg-white/[0.02] border border-white/10 hover:border-recruiter-accent/60 hover:bg-white/[0.06] rounded-2xl text-white hover:text-recruiter-accent-light transition-all shadow-sm hover:shadow-[0_0_15px_rgba(0,102,255,0.2)] flex items-center justify-center shrink-0 cursor-pointer flex-1"
              title="LinkedIn"
              aria-label="LinkedIn"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
                <rect width="4" height="12" x="2" y="9"/>
                <circle cx="4" cy="4" r="2"/>
              </svg>
            </a>
          )}

          {github && (
            <a
              href={github}
              target="_blank"
              rel="noopener noreferrer"
              class="p-3 bg-white/[0.02] border border-white/10 hover:border-recruiter-accent/60 hover:bg-white/[0.06] rounded-2xl text-white hover:text-recruiter-accent-light transition-all shadow-sm hover:shadow-[0_0_15px_rgba(0,102,255,0.2)] flex items-center justify-center shrink-0 cursor-pointer flex-1"
              title="GitHub"
              aria-label="GitHub"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
                <path d="M9 18c-4.51 2-5-2-7-2"/>
              </svg>
            </a>
          )}
        </div>
      </div>
    </div>

    <!-- Divider for larger screens -->
    <div class="hidden md:block w-[1px] bg-white/10 my-2 self-stretch"></div>

    <!-- Right Column: Bio & Age & Availability (Scroll reveal animations) -->
    <div class="flex-1 flex flex-col justify-between gap-6 py-2">
      <div>
        <h2 class="text-xl font-bold text-white mb-3">Sobre mí</h2>
        <p class="text-sm sm:text-base text-white/70 leading-relaxed max-w-xl">
          {bio}
        </p>
      </div>

      <div class="flex flex-col sm:flex-row gap-4 mt-4 w-full">
        {age !== null && (
          <div class="bg-white/[0.02] border border-white/10 rounded-2xl px-5 py-4 backdrop-blur-md hover:border-recruiter-accent/30 hover:shadow-[0_0_20px_rgba(0,102,255,0.05)] transition-all duration-300 flex flex-col justify-center min-w-[120px]">
            <span class="block text-xs uppercase tracking-wider text-white/40 mb-1">Edad</span>
            <span class="text-2xl font-extrabold text-white">{age} <span class="text-xs font-normal text-white/40">años</span></span>
          </div>
        )}

        <div class="bg-white/[0.02] border border-white/10 rounded-2xl px-5 py-4 backdrop-blur-md flex-1 hover:border-recruiter-accent/30 hover:shadow-[0_0_20px_rgba(0,102,255,0.05)] transition-all duration-300 flex flex-col justify-center min-w-[200px]">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs uppercase tracking-wider text-white/40">Disponibilidad</span>
            <span class="text-sm font-bold text-recruiter-accent-light">{availability}%</span>
          </div>
          <div class="h-2 bg-white/10 rounded-full overflow-hidden p-[1px]">
            <div
              class="h-full bg-gradient-to-r from-recruiter-accent to-recruiter-accent-light rounded-full transition-all duration-[1.2s] cubic-bezier(0.16, 1, 0.3, 1) progress-bar"
              style={`--target-width: ${availability}%; width: 0%;`}
            ></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .recruiter-gradient-bg {
    background: linear-gradient(135deg, var(--color-recruiter-accent-dark) 0%, #10141e 50%, #080c14 100%);
    background-size: 200% 200%;
    animation: recruiter-gradient-shift 12s ease-in-out infinite;
  }

  @keyframes recruiter-gradient-shift {
    0% { background-position: 0% 0%; }
    50% { background-position: 100% 100%; }
    100% { background-position: 0% 0%; }
  }

  /* Floating Animation for Avatar */
  @keyframes float {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }
  .animate-float {
    animation: float 6s ease-in-out infinite;
  }

  /* Soft Text Reveal Animation */
  @keyframes text-reveal {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .hero-text-reveal {
    animation: text-reveal 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  /* Reveal progress bar when container has .visible class */
  :global(.recruiter-section.visible) .progress-bar {
    width: var(--target-width) !important;
  }
</style>
