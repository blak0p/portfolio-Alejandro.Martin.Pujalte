---
interface HeroProps {
  name: string;
  handle: string;
  status?: string;
  photo?: string;
  email?: string;
  linkedin?: string;
  github?: string;
}

const { name, handle, photo = '/profile.jpg', email, linkedin, github } = Astro.props;
---

<section class="relative w-full min-h-[70vh] flex items-center justify-center overflow-hidden recruiter-hero">
  <!-- Animated warm gradient backdrop -->
  <div class="absolute inset-0 -z-10 recruiter-gradient-bg" aria-hidden="true"></div>

  <!-- Large circular photo — beside name on desktop, stacked above on mobile -->
  <div class="relative z-10 flex flex-col md:flex-row items-center justify-center gap-6 px-6">
    <div class="w-48 h-48 rounded-full overflow-hidden border border-recruiter-accent/20 shadow-[0_0_40px_rgba(0,102,255,0.15)] shrink-0">
      <img
        src={photo}
        alt={name}
        class="w-full h-full object-cover"
        loading="eager"
        decoding="async"
      />
    </div>

    <div class="flex flex-col items-center md:items-start gap-2">
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-white leading-tight text-center md:text-left">
        {name.replace('\n', ' ')}
      </h1>
      <p class="text-base sm:text-lg text-recruiter-accent-light/80 font-medium">
        {handle}
      </p>
    </div>
  </div>
</section>

<style>
  .recruiter-gradient-bg {
    background: linear-gradient(135deg, var(--color-recruiter-accent-dark) 0%, #181818 55%, #0d0d0d 100%);
    background-size: 200% 200%;
    animation: recruiter-gradient-shift 14s ease-in-out infinite;
  }

  @keyframes recruiter-gradient-shift {
    0% { background-position: 0% 0%; }
    50% { background-position: 100% 100%; }
    100% { background-position: 0% 0%; }
  }
</style>
