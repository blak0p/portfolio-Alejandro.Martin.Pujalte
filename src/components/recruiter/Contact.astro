---
interface ExternalLink {
  label: string;
  href: string;
}

interface ContactProps {
  contactEmail?: string;
  links?: ExternalLink[];
  linkedinUrl?: string;
}

const { contactEmail, links = [], linkedinUrl } = Astro.props;

// Merge explicit links with LinkedIn (if not already present)
const allLinks: ExternalLink[] = [];
if (linkedinUrl && !links.some((l) => l.href === linkedinUrl)) {
  allLinks.push({ label: 'LinkedIn', href: linkedinUrl });
}
allLinks.push(...links);
---

<section class="recruiter-section" id="contact">
  <div class="recruiter-container">
    <h2 class="recruiter-section-title">Contacto</h2>

    <div class="flex flex-col gap-3.5 max-w-md">
      {contactEmail && (
        <a
          href={`mailto:${contactEmail}`}
          class="group flex items-center justify-between gap-4 bg-white/[0.02] border border-white/10 rounded-2xl px-6 py-4 hover:border-recruiter-accent/50 hover:shadow-[0_8px_30px_rgba(0,102,255,0.15)] hover:-translate-y-0.5 transition-all duration-300 backdrop-blur-md cursor-pointer"
        >
          <div class="flex items-center gap-3">
            <span class="text-sm font-semibold text-recruiter-accent-light shrink-0">Email</span>
            <span class="text-sm text-white/70 group-hover:text-white transition-colors">{contactEmail}</span>
          </div>
          <span class="text-white/30 group-hover:text-recruiter-accent-light group-hover:translate-x-1.5 transition-all duration-300 font-mono">→</span>
        </a>
      )}

      {allLinks.map((link) => (
        <a
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center justify-between gap-4 bg-white/[0.02] border border-white/10 rounded-2xl px-6 py-4 hover:border-recruiter-accent/50 hover:shadow-[0_8px_30px_rgba(0,102,255,0.15)] hover:-translate-y-0.5 transition-all duration-300 backdrop-blur-md cursor-pointer"
        >
          <span class="text-sm font-semibold text-recruiter-accent-light shrink-0">{link.label}</span>
          <span class="text-white/30 group-hover:text-recruiter-accent-light group-hover:translate-x-1.5 transition-all duration-300 font-mono">→</span>
        </a>
      ))}
    </div>
  </div>
</section>
