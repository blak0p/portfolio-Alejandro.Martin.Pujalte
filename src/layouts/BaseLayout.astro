---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title?: string;
  description?: string;
  handle?: string;
  navStyle?: 'dev' | 'recruiter' | 'none';
}

const {
  title = 'Alejandro Martín Pujalte \u2014 Desarrollador backend junior',
  description = 'Desarrollador backend junior en Valencia. Go, Java y herramientas para desarrolladores. Busco mi primer puesto, en remoto o en Valencia.',
  handle = 'blak0p',
  navStyle = 'dev',
} = Astro.props;

const ogImage = '/profile.jpg';
const siteUrl = Astro.site ?? 'https://alejandro-mp.dev';

const pathname = Astro.url.pathname.replace(/\/$/, '');
const isDevPage = pathname === '/dev';
const deploymentsHref = isDevPage ? '#deployments' : '/dev#deployments';
const techHref = isDevPage ? '#tech' : '/dev#tech';

---

<!doctype html>
<html lang="es">
  <head>
    <script is:inline>
      // Prevent React from crashing when Google Translate mutates the DOM
      if (typeof Node !== 'undefined' && Node.prototype) {
        const originalRemoveChild = Node.prototype.removeChild;
        Node.prototype.removeChild = function(child) {
          if (child.parentNode !== this) {
            return child;
          }
          return originalRemoveChild.call(this, child);
        };
        const originalInsertBefore = Node.prototype.insertBefore;
        Node.prototype.insertBefore = function(newNode, referenceNode) {
          if (referenceNode && referenceNode.parentNode !== this) {
            return originalInsertBefore.call(this, newNode, null);
          }
          return originalInsertBefore.call(this, newNode, referenceNode);
        };
      }
    </script>
    <ClientRouter />
    <script is:inline>
      // The site is written in Spanish. A leftover "translate to Spanish" cookie
      // (e.g. googtrans=/auto/es) makes Google re-translate English-looking
      // labels (WHOAMI, stack, merged...), so drop it before element.js reads it.
      (function () {
        if (!/(?:^|;\s*)googtrans=\/[^/;]*\/es(?:;|$)/.test(document.cookie)) return;
        var expired = 'googtrans=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/;';
        var host = window.location.hostname;
        document.cookie = expired;
        document.cookie = expired + ' domain=' + host;
        document.cookie = expired + ' domain=.' + host;
      })();

      window.googleTranslateElementInit = function() {
        const el = document.getElementById('google_translate_element');
        if (!el) return;
        if (el.querySelector('.goog-te-combo')) return;
        
        new google.translate.TranslateElement({
          pageLanguage: 'es',
          includedLanguages: 'es,en',
          layout: google.translate.TranslateElement.InlineLayout.SIMPLE,
          autoDisplay: false
        }, 'google_translate_element');
      };

      document.addEventListener('astro:page-load', () => {
        if (window.googleTranslateElementInit && window.google && window.google.translate && window.google.translate.TranslateElement) {
          window.googleTranslateElementInit();
        }
      });
    </script>
    <script is:inline src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, siteUrl).toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, siteUrl).toString()} />
    <style define:vars={{ bgPage: navStyle === 'recruiter' ? '#080c14' : '#0d0d0d' }}>
      html, body {
        background-color: var(--bgPage) !important;
      }
    </style>
    <Analytics />
  </head>
  <body class={navStyle === 'recruiter' ? 'bg-[#080c14] text-white font-sans' : 'bg-carbono text-text-primary font-mono'}>

    <!-- Single Google Translate host (hidden); language is switched via [data-translate] controls -->
    <div id="google_translate_element" class="google-translate-dropdown" aria-hidden="true"></div>

    {navStyle === 'dev' && (
      <Fragment>
        <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] focus:bg-cobalt focus:text-white focus:px-3 focus:py-2">Saltar al contenido</a>
      <!-- DEV NAV — sharp, cyberpunk, existing style -->
      <nav class="fixed top-0 left-0 right-0 z-50 border-b border-white/15 bg-carbono/80 backdrop-blur-md h-12">
        <div class="w-full px-4 sm:px-6 lg:px-8 h-full flex items-center justify-between">

          <a href="/" class="text-sm font-bold tracking-widest text-white hover:text-cobalt transition-colors duration-100 shrink-0">
            {handle.replace('@', '').toUpperCase()}
          </a>

          <!-- Desktop links — point at dev page sections -->
          <div class="hidden md:flex items-center gap-5 text-xs text-text-muted tracking-widest uppercase">
            <a href={deploymentsHref} class="hover:text-cobalt transition-colors duration-100">Proyectos</a>
            <span class="text-white/20">|</span>
            <a href={techHref} class="hover:text-cobalt transition-colors duration-100">Tecnologías</a>
            <span class="text-white/20">|</span>
            <span class="text-text-faint/40 normal-case tracking-normal">Para técnicos</span>
            <a href="/" class="text-text-faint/40 hover:text-white transition-colors duration-100 normal-case tracking-normal">← Recruiter</a>
          </div>

          <div class="flex items-center gap-3">
            <div class="flex items-center gap-2 select-none shrink-0">
              <button type="button" class="translate-btn text-xs font-bold tracking-widest cursor-pointer px-1 text-text-muted hover:text-white" data-translate="es" aria-label="Español" aria-pressed="false">ES</button>
              <button type="button" class="translate-btn text-xs font-bold tracking-widest cursor-pointer px-1 text-text-muted hover:text-white" data-translate="en" aria-label="English" aria-pressed="false">EN</button>
            </div>

            <!-- Hamburger (mobile only) -->
            <button
              id="hamburger"
              class="md:hidden flex flex-col gap-1.5 p-1 text-text-faint hover:text-white transition-colors"
              aria-label="Menú"
            >
              <span class="block w-5 h-px bg-current transition-all duration-200" id="bar1"></span>
              <span class="block w-5 h-px bg-current transition-all duration-200" id="bar2"></span>
              <span class="block w-5 h-px bg-current transition-all duration-200" id="bar3"></span>
            </button>
          </div>

        </div>
      </nav>

      <!-- Fullscreen mobile menu (dev) -->
      <div
        id="mobile-menu"
        class="fixed inset-0 z-40 md:hidden bg-carbono/98 backdrop-blur-xl flex-col items-center justify-center hidden"
      >
        <button id="mobile-close" class="absolute top-4 right-4 text-text-faint hover:text-white text-3xl transition-colors" aria-label="Cerrar">&times;</button>

        <!-- Nav links — mismo texto y estilo que desktop -->
        <nav class="flex flex-col items-center gap-8 text-xs text-text-muted tracking-widest uppercase">
          <a href={deploymentsHref} class="mobile-link hover:text-cobalt transition-colors duration-100">Proyectos</a>
          <span class="text-white/20">|</span>
          <a href={techHref}        class="mobile-link hover:text-cobalt transition-colors duration-100">Tecnologías</a>
        </nav>

        <!-- Flags -->
        <div class="flex items-center gap-3 mt-10 select-none">
          <button type="button" class="translate-btn text-sm font-bold tracking-widest text-text-muted hover:text-white" data-translate="es" aria-label="Español" aria-pressed="false">ES</button>
          <button type="button" class="translate-btn text-sm font-bold tracking-widest text-text-muted hover:text-white" data-translate="en" aria-label="English" aria-pressed="false">EN</button>
        </div>

        <!-- Volver a modo recruiter -->
        <div class="absolute bottom-8 left-0 right-0 flex justify-center">
          <a href="/" class="mobile-link text-xs text-text-faint/50 hover:text-white tracking-widest uppercase transition-colors">← Volver a modo recruiter</a>
        </div>
      </div>
      </Fragment>
    )}

    {navStyle === 'dev' ? (
      <main id="main" class="pt-12"><slot /></main>
    ) : (
      <slot />
    )}

    <script>
      function initHamburger() {
        // Reset body scroll in case a previous menu was open
        document.body.style.overflow = '';

        // ── DEV hamburger ──
        const hamburger = document.getElementById('hamburger');
        const menu      = document.getElementById('mobile-menu');
        const closeBtn  = document.getElementById('mobile-close');
        const bar1      = document.getElementById('bar1');
        const bar2      = document.getElementById('bar2');
        const bar3      = document.getElementById('bar3');

        let open = false;

        function toggle() {
          open = !open;
          menu?.classList.toggle('hidden', !open);
          menu?.classList.toggle('flex', open);
          document.body.style.overflow = open ? 'hidden' : '';
          if (bar1) bar1.style.transform = open ? 'translateY(7px) rotate(45deg)' : '';
          if (bar2) bar2.style.opacity   = open ? '0' : '1';
          if (bar3) bar3.style.transform = open ? 'translateY(-7px) rotate(-45deg)' : '';
        }

        hamburger?.addEventListener('click', toggle);
        closeBtn?.addEventListener('click', () => { if (open) toggle(); });
        document.querySelectorAll('.mobile-link').forEach(link => {
          link.addEventListener('click', () => { if (open) toggle(); });
        });
      }

      // Google Translate click triggers
      function triggerTranslation(lang: string) {
        // Spanish is the original language: clear the cookie instead of
        // asking Google to "translate" es -> es (it mangles tech names).
        if (lang === 'es') {
          const expired = '; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/;';
          document.cookie = 'googtrans=' + expired;
          document.cookie = 'googtrans=' + expired + ' domain=' + window.location.hostname;
          document.cookie = 'googtrans=' + expired + ' domain=.' + window.location.hostname;
          window.location.reload();
          return;
        }
        document.cookie = "googtrans=/es/" + lang + "; path=/;";
        document.cookie = "googtrans=/es/" + lang + "; path=/; domain=" + window.location.hostname;
        const combo = document.querySelector('.goog-te-combo') as HTMLSelectElement | null;
        if (combo) {
          combo.value = lang;
          combo.dispatchEvent(new Event('change'));
        } else {
          window.location.reload();
        }
      }

      function currentLang(): string {
        const m = document.cookie.match(/(?:^|;\s*)googtrans=\/[^/]*\/([a-z-]+)/i);
        return m ? m[1] : 'es';
      }

      function syncTranslationButtons() {
        const lang = currentLang();
        document.querySelectorAll<HTMLElement>('[data-translate]').forEach((el) => {
          el.setAttribute('aria-pressed', String(el.dataset.translate === lang));
        });
      }

      // Event delegation: any [data-translate="es|en"] element switches language.
      const w = window as any;
      if (!w.__translateDelegated) {
        w.__translateDelegated = true;
        document.addEventListener('click', (e) => {
          const el = (e.target as HTMLElement | null)?.closest<HTMLElement>('[data-translate]');
          const lang = el?.dataset.translate;
          if (lang === 'es' || lang === 'en') {
            triggerTranslation(lang);
            syncTranslationButtons();
          }
        });
      }

      // Run on every page load (includes view transitions)
      initHamburger();
      syncTranslationButtons();
      document.addEventListener('astro:page-load', () => {
        initHamburger();
        syncTranslationButtons();
      });
    </script>

  </body>
</html>
