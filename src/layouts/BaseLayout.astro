---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  handle?: string;
  status?: string;
  navStyle?: 'dev' | 'recruiter';
}

const {
  title = 'ALEJANDRO MARTIN PUJALTE \u2014 Desarrollador Backend',
  description = 'Desarrollador Backend construyendo infraestructura de alta disponibilidad, herramientas de IA local y arquitecturas estructuralmente honestas.',
  handle = 'blak0p',
  status = 'ONLINE',
  navStyle = 'dev',
} = Astro.props;

const ogImage = '/profile.jpg';
const siteUrl = Astro.site ?? 'https://alejandro-mp.dev';

const isDevPage = Astro.url.pathname.replace(/\/$/, '') === '/dev';
const deploymentsHref = isDevPage ? '#deployments' : '/dev#deployments';
const techHref = isDevPage ? '#tech' : '/dev#tech';
const ambitionsHref = isDevPage ? '#ambitions' : '/dev#ambitions';
---

<html lang="es">
  <head>
    <script is:inline>
      // Prevent React from crashing when Google Translate mutates the DOM
      if (typeof Node !== 'undefined' && Node.prototype) {
        const originalRemoveChild = Node.prototype.removeChild;
        Node.prototype.removeChild = function(child) {
          if (child.parentNode !== this) {
            return child;
          }
          return originalRemoveChild.call(this, child);
        };
        const originalInsertBefore = Node.prototype.insertBefore;
        Node.prototype.insertBefore = function(newNode, referenceNode) {
          if (referenceNode && referenceNode.parentNode !== this) {
            return originalInsertBefore.call(this, newNode, null);
          }
          return originalInsertBefore.call(this, newNode, referenceNode);
        };
      }
    </script>
    <ClientRouter />
    <script is:inline>
      window.googleTranslateElementInit = function() {
        const el = document.getElementById('google_translate_element');
        if (!el) return;
        if (el.querySelector('.goog-te-combo')) return;
        
        new google.translate.TranslateElement({
          pageLanguage: 'auto',
          includedLanguages: 'es,en',
          layout: google.translate.TranslateElement.InlineLayout.SIMPLE,
          autoDisplay: false
        }, 'google_translate_element');
      };

      document.addEventListener('astro:page-load', () => {
        if (window.googleTranslateElementInit && window.google && window.google.translate && window.google.translate.TranslateElement) {
          window.googleTranslateElementInit();
        }
      });
    </script>
    <script is:inline src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, siteUrl).toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, siteUrl).toString()} />
    <style define:vars={{ bgPage: navStyle === 'recruiter' ? '#080c14' : '#0d0d0d' }}>
      html, body {
        background-color: var(--bgPage) !important;
      }
    </style>
  </head>
  <body class={navStyle === 'recruiter' ? 'bg-[#080c14] text-white font-sans' : 'bg-carbono text-text-primary font-mono'}>

    {navStyle === 'recruiter' ? (
      <!-- RECRUITER NAV — rounded, professional deep blue theme -->
      <nav class="fixed top-0 left-0 right-0 z-50 bg-[#080c14]/85 backdrop-blur-md border-b border-white/10 h-14">
        <div class="max-w-5xl mx-auto px-6 h-full flex items-center justify-between">
          <a href="/" class="text-sm font-bold tracking-wide text-white/90 hover:text-recruiter-accent-light transition-colors">
            {handle.replace('@', '').toUpperCase()}
          </a>

          <!-- Desktop links (recruiter) -->
          <div class="hidden md:flex items-center gap-6 text-sm text-white/70 font-medium">
            <a href="/#about" class="hover:text-recruiter-accent-light transition-colors">Sobre mí</a>
            <a href="/#projects" class="hover:text-recruiter-accent-light transition-colors">Proyectos</a>
            <a href="/#tech" class="hover:text-recruiter-accent-light transition-colors">Tecnologías</a>
            <a href="/#ambitions" class="hover:text-recruiter-accent-light transition-colors">Metas</a>
            <a href="/#contact" class="hover:text-recruiter-accent-light transition-colors">Contacto</a>
            <a href="/bitacora" class="hover:text-recruiter-accent-light transition-colors">Bitácora</a>
            <span class="text-white/20">|</span>
            <div id="google_translate_element" class="google-translate-dropdown"></div>
            <div class="flex items-center gap-2 select-none shrink-0">
              <button class="translate-btn text-base hover:scale-110 active:scale-95 transition-all cursor-pointer p-0.5" data-lang="es" title="Español">🇪🇸</button>
              <button class="translate-btn text-base hover:scale-110 active:scale-95 transition-all cursor-pointer p-0.5" data-lang="en" title="English">🇬🇧</button>
            </div>
            <span class="text-white/20">|</span>
            <a href="/dev" class="text-xs text-white/40 hover:text-recruiter-accent-light transition-colors tracking-wider uppercase">Dev</a>
          </div>

          <!-- Mobile right side (recruiter) -->
          <div class="flex md:hidden items-center gap-3">
            <div id="google_translate_element_r" class="google-translate-dropdown"></div>
            <div class="flex items-center gap-2 select-none shrink-0">
              <button class="translate-btn text-base hover:scale-110 active:scale-95 transition-all cursor-pointer p-0.5" data-lang="es" title="Español">🇪🇸</button>
              <button class="translate-btn text-base hover:scale-110 active:scale-95 transition-all cursor-pointer p-0.5" data-lang="en" title="English">🇬🇧</button>
            </div>
            <!-- Hamburger recruiter -->
            <button
              id="hamburger-r"
              class="flex flex-col gap-1.5 p-1 text-white/60 hover:text-white transition-colors"
              aria-label="Menú"
            >
              <span class="block w-5 h-px bg-current transition-all duration-200" id="rbar1"></span>
              <span class="block w-5 h-px bg-current transition-all duration-200" id="rbar2"></span>
              <span class="block w-5 h-px bg-current transition-all duration-200" id="rbar3"></span>
            </button>
          </div>
        </div>
      </nav>

      <!-- Fullscreen mobile menu (recruiter) -->
      <div
        id="mobile-menu-r"
        class="fixed inset-0 z-40 md:hidden bg-[#080c14]/98 backdrop-blur-xl flex-col items-center justify-center hidden"
      >
        <button id="mobile-close-r" class="absolute top-5 right-5 text-white/50 hover:text-white text-3xl transition-colors" aria-label="Cerrar">&times;</button>
        <nav class="flex flex-col items-center gap-8 text-xl font-medium">
          <a href="/#about"    class="mobile-link-r text-white/80 hover:text-recruiter-accent-light transition-colors">Sobre mí</a>
          <a href="/#projects" class="mobile-link-r text-white/80 hover:text-recruiter-accent-light transition-colors">Proyectos</a>
          <a href="/#tech"     class="mobile-link-r text-white/80 hover:text-recruiter-accent-light transition-colors">Tecnologías</a>
          <a href="/#ambitions" class="mobile-link-r text-white/80 hover:text-recruiter-accent-light transition-colors">Metas</a>
          <a href="/#contact"  class="mobile-link-r text-white/80 hover:text-recruiter-accent-light transition-colors">Contacto</a>
          <a href="/bitacora"  class="mobile-link-r text-white/80 hover:text-recruiter-accent-light transition-colors">Bitácora</a>
          <a href="/dev" class="mt-4 text-sm text-white/30 hover:text-recruiter-accent-light transition-colors tracking-wider uppercase">Dev</a>
        </nav>
      </div>
    ) : (
      <!-- DEV NAV — sharp, cyberpunk, existing style -->
      <nav class="fixed top-0 left-0 right-0 z-50 border-b border-white/15 bg-carbono/80 backdrop-blur-md h-12">
        <div class="w-full px-4 sm:px-6 lg:px-8 h-full flex items-center justify-between">

          <a href="/" class="text-sm font-bold tracking-widest text-white hover:text-cobalt transition-colors duration-100 shrink-0">
            {handle.replace('@', '').toUpperCase()}
          </a>

          <!-- Desktop links — point at dev page sections -->
          <div class="hidden md:flex items-center gap-5 text-xs text-text-muted tracking-widest uppercase">
            <a href={deploymentsHref} class="hover:text-cobalt transition-colors duration-100">Proyectos</a>
            <span class="text-white/20">|</span>
            <a href={techHref} class="hover:text-cobalt transition-colors duration-100">Tecnologías</a>
            <span class="text-white/20">|</span>
            <a href={ambitionsHref} class="hover:text-cobalt transition-colors duration-100">Metas</a>
            <span class="text-white/20">|</span>
            <a href="/dev/bitacora" class="hover:text-cobalt transition-colors duration-100">Bitácora</a>
            <span class="text-white/20">|</span>
            <span class="text-text-faint/40 normal-case tracking-normal">Para técnicos</span>
            <a href="/" class="text-text-faint/40 hover:text-white transition-colors duration-100 normal-case tracking-normal">← Recruiter</a>
          </div>

          <div class="flex items-center gap-3">
            <div class="hidden sm:flex items-center gap-1.5 text-xs text-text-faint tracking-widest">
              <span class={`w-1.5 h-1.5 ${status === 'ONLINE' ? 'bg-cobalt' : status === 'BUSY' ? 'bg-warn' : 'bg-text-faint'} animate-pulse inline-block`} style="border-radius:50%"></span>
              <span class={status === 'ONLINE' ? 'text-cobalt' : status === 'BUSY' ? 'text-warn' : 'text-text-faint'}>{status}</span>
            </div>
            <span class="hidden sm:inline text-white/20">|</span>
            <div id="google_translate_element" class="google-translate-dropdown"></div>
            <div class="flex items-center gap-2 select-none shrink-0">
              <button class="translate-btn text-base hover:scale-110 active:scale-95 transition-all cursor-pointer p-0.5" data-lang="es" title="Español">🇪🇸</button>
              <button class="translate-btn text-base hover:scale-110 active:scale-95 transition-all cursor-pointer p-0.5" data-lang="en" title="English">🇬🇧</button>
            </div>

            <!-- Hamburger (mobile only) -->
            <button
              id="hamburger"
              class="md:hidden flex flex-col gap-1.5 p-1 text-text-faint hover:text-white transition-colors"
              aria-label="Menú"
            >
              <span class="block w-5 h-px bg-current transition-all duration-200" id="bar1"></span>
              <span class="block w-5 h-px bg-current transition-all duration-200" id="bar2"></span>
              <span class="block w-5 h-px bg-current transition-all duration-200" id="bar3"></span>
            </button>
          </div>

        </div>
      </nav>

      <!-- Fullscreen mobile menu (dev) -->
      <div
        id="mobile-menu"
        class="fixed inset-0 z-40 md:hidden bg-carbono/98 backdrop-blur-xl flex-col items-center justify-center hidden"
      >
        <button id="mobile-close" class="absolute top-4 right-4 text-text-faint hover:text-white text-3xl transition-colors" aria-label="Cerrar">&times;</button>

        <!-- Status -->
        <div class="flex items-center gap-1.5 text-xs tracking-widest mb-10">
          <span class={`w-1.5 h-1.5 ${status === 'ONLINE' ? 'bg-cobalt' : status === 'BUSY' ? 'bg-warn' : 'bg-text-faint'} animate-pulse inline-block`} style="border-radius:50%"></span>
          <span class={status === 'ONLINE' ? 'text-cobalt' : status === 'BUSY' ? 'text-warn' : 'text-text-faint'}>{status}</span>
        </div>

        <!-- Nav links — mismo texto y estilo que desktop -->
        <nav class="flex flex-col items-center gap-8 text-xs text-text-muted tracking-widest uppercase">
          <a href={deploymentsHref} class="mobile-link hover:text-cobalt transition-colors duration-100">Proyectos</a>
          <span class="text-white/20">|</span>
          <a href={techHref}        class="mobile-link hover:text-cobalt transition-colors duration-100">Tecnologías</a>
          <span class="text-white/20">|</span>
          <a href={ambitionsHref}   class="mobile-link hover:text-cobalt transition-colors duration-100">Metas</a>
          <span class="text-white/20">|</span>
          <a href="/dev/bitacora"   class="mobile-link hover:text-cobalt transition-colors duration-100">Bitácora</a>
        </nav>

        <!-- Flags -->
        <div class="flex items-center gap-3 mt-10 select-none">
          <button class="translate-btn text-base hover:scale-110 active:scale-95 transition-all cursor-pointer p-0.5" data-lang="es" title="Español">🇪🇸</button>
          <button class="translate-btn text-base hover:scale-110 active:scale-95 transition-all cursor-pointer p-0.5" data-lang="en" title="English">🇬🇧</button>
        </div>

        <!-- Volver a modo recruiter -->
        <div class="absolute bottom-8 left-0 right-0 flex justify-center">
          <a href="/" class="mobile-link text-xs text-text-faint/50 hover:text-white tracking-widest uppercase transition-colors">← Volver a modo recruiter</a>
        </div>
      </div>
    )}

    <main class={navStyle === 'recruiter' ? 'pt-14' : 'pt-12'}>
      <slot />
    </main>

    <script>
      function initHamburger() {
        // Reset body scroll in case a previous menu was open
        document.body.style.overflow = '';

        // ── DEV hamburger ──
        const hamburger = document.getElementById('hamburger');
        const menu      = document.getElementById('mobile-menu');
        const closeBtn  = document.getElementById('mobile-close');
        const bar1      = document.getElementById('bar1');
        const bar2      = document.getElementById('bar2');
        const bar3      = document.getElementById('bar3');

        let open = false;

        function toggle() {
          open = !open;
          menu?.classList.toggle('hidden', !open);
          menu?.classList.toggle('flex', open);
          document.body.style.overflow = open ? 'hidden' : '';
          if (bar1) bar1.style.transform = open ? 'translateY(7px) rotate(45deg)' : '';
          if (bar2) bar2.style.opacity   = open ? '0' : '1';
          if (bar3) bar3.style.transform = open ? 'translateY(-7px) rotate(-45deg)' : '';
        }

        hamburger?.addEventListener('click', toggle);
        closeBtn?.addEventListener('click', () => { if (open) toggle(); });
        document.querySelectorAll('.mobile-link').forEach(link => {
          link.addEventListener('click', () => { if (open) toggle(); });
        });

        // ── RECRUITER hamburger ──
        const hamburgerR = document.getElementById('hamburger-r');
        const menuR      = document.getElementById('mobile-menu-r');
        const closeBtnR  = document.getElementById('mobile-close-r');
        const rbar1      = document.getElementById('rbar1');
        const rbar2      = document.getElementById('rbar2');
        const rbar3      = document.getElementById('rbar3');

        let openR = false;

        function toggleR() {
          openR = !openR;
          menuR?.classList.toggle('hidden', !openR);
          menuR?.classList.toggle('flex', openR);
          document.body.style.overflow = openR ? 'hidden' : '';
          if (rbar1) rbar1.style.transform = openR ? 'translateY(7px) rotate(45deg)' : '';
          if (rbar2) rbar2.style.opacity   = openR ? '0' : '1';
          if (rbar3) rbar3.style.transform = openR ? 'translateY(-7px) rotate(-45deg)' : '';
        }

        hamburgerR?.addEventListener('click', toggleR);
        closeBtnR?.addEventListener('click', () => { if (openR) toggleR(); });
        document.querySelectorAll('.mobile-link-r').forEach(link => {
          link.addEventListener('click', () => { if (openR) toggleR(); });
        });
      }

      // Google Translate click triggers
      function triggerTranslation(lang: string) {
        document.cookie = "googtrans=/auto/" + lang + "; path=/;";
        document.cookie = "googtrans=/auto/" + lang + "; path=/; domain=" + window.location.hostname;
        const combo = document.querySelector('.goog-te-combo') as HTMLSelectElement | null;
        if (combo) {
          combo.value = lang;
          combo.dispatchEvent(new Event('change'));
        } else {
          window.location.reload();
        }
      }

      function initTranslationButtons() {
        document.querySelectorAll('.translate-btn').forEach(btn => {
          btn.addEventListener('click', (e) => {
            const target = e.currentTarget as HTMLElement;
            const lang = target.dataset.lang;
            if (lang) triggerTranslation(lang);
          });
        });
      }

      // Run on every page load (includes view transitions)
      initHamburger();
      initTranslationButtons();
      document.addEventListener('astro:page-load', () => {
        initHamburger();
        initTranslationButtons();
      });
    </script>

  </body>
</html>
