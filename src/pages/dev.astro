---
import BaseLayout from '../layouts/BaseLayout.astro';
import IdentitySection from '../components/identity/IdentitySection';
import ProjectGrid from '../components/deployments/ProjectGrid';
import TechMatrix from '../components/techstack/TechMatrix';
import CoreConsole from '../components/terminal/CoreConsole';
import Roadmap from '../components/ambitions/Roadmap';
import CoreHome from '../components/ui/CoreHome';
import ambitions from '../../public/data/ambitions.json';
import identity from '../../public/data/identity.json';
import logs from '../../public/data/logs.json';
import settings from '../../public/data/settings.json';
import techStack from '../../public/data/techstack.json';
import projects from '../../public/data/projects.json';

// Merge identity with settings (settings override identity for dynamic values)
const identityData = {
  ...identity,
  status: settings.status ?? identity.status,
  availabilityValue: settings.availabilityValue ?? identity.availabilityValue,
  cvUrl: settings.cvUrl ?? identity.cvUrl,
  linkedinUrl: settings.linkedinUrl ?? identity.linkedinUrl,
  birthDate: settings.birthDate ?? (identity as any).birthDate,
};

const totalProjects = projects.length;
const totalTech = techStack.length;
---

<BaseLayout 
  title={`${identityData.name.replace('\n', ' ')} \u2014 Desarrollador Backend`} 
  description={identityData.bio}
  handle={identityData.handle}
  status={identityData.status}
>
  <div class="w-full h-[calc(100vh-48px)] p-2 md:p-3 overflow-hidden flex flex-col gap-2 md:gap-3 boot-up">
    
    <!-- DESKTOP: 2-column layout -->
    <div class="hidden lg:grid lg:grid-cols-[clamp(280px,22vw,380px)_1fr] flex-1 min-h-0 gap-3 sharp-corner">
      
      <!-- LEFT: Identity + Console (con pestañas) -->
      <aside class="flex flex-col gap-0 min-h-0">
        <!-- Tab bar -->
        <div class="flex border border-white/15 border-b-0 bg-carbono-surface sharp-corner" id="left-tabs">
          <button data-tab="profile" class="flex-1 py-2 text-xs font-black tracking-widest uppercase border-r border-white/10 bg-cobalt text-white transition-all">// PERFIL</button>
          <button data-tab="terminal" class="flex-1 py-2 text-xs font-black tracking-widest uppercase text-white/50 hover:text-white transition-all">// TERMINAL</button>
        </div>
        <!-- Tab content -->
        <div id="tab-profile" class="flex-1 border border-white/15 border-t-0 bg-carbono-surface overflow-hidden sharp-corner island-wrapper min-h-[450px]">
            <div class="island-placeholder absolute inset-0 bg-carbono-surface"></div>
            <IdentitySection {...identityData} client:only="react" />
        </div>
        <div id="tab-terminal" class="hidden flex-1 border border-white/15 border-t-0 bg-carbono-surface overflow-hidden sharp-corner">
          <div class="h-full overflow-hidden island-wrapper min-h-[450px]">
            <div class="island-placeholder absolute inset-0 bg-carbono-surface"></div>
            <CoreConsole 
              logs={logs} 
              logLimit={settings.logLimit ?? 10} 
              projects={projects}
              settings={settings}
              identity={identityData}
              techStack={techStack}
              client:only="react" 
            />
          </div>
        </div>
      </aside>

      <!-- RIGHT: Projects TOP, TechStack+Roadmap BOTTOM (side by side) -->
      <main class="flex flex-col gap-3 min-h-0">
        
        <!-- PROJECTS (arriba) -->
        <section id="deployments" class="border border-white/15 bg-carbono-surface p-3 overflow-hidden" style="flex: 1.2">
          <div class="h-full overflow-y-auto">
            <div class="mb-3 shrink-0">
              <div class="flex items-center justify-between pb-2">
                <span class="text-sm font-bold text-white tracking-widest">// PROYECTOS</span>
              </div>
              <div class="h-0.5 w-full bg-cobalt shadow-[0_0_10px_rgba(0,85,255,0.3)]"></div>
            </div>
            <div class="island-wrapper min-h-[250px] h-full">
              <div class="island-placeholder absolute inset-0 bg-carbono-surface"></div>
              <ProjectGrid projects={projects} client:only="react" />
            </div>
          </div>
        </section>

        <!-- BOTTOM: Dashboard de Módulos -->
        <div class="grid grid-cols-3 gap-3 min-h-0" style="flex: 2">

          <!-- TechStack -->
          <section id="tech" class="border border-white/15 bg-carbono-surface p-3 overflow-hidden">
            <div class="h-full overflow-y-auto">
              <div class="mb-2">
                <div class="flex items-center justify-between pb-2">
                  <span class="text-sm font-bold text-white tracking-widest">// TECH_STACK_RECIENTE</span>
                </div>
                <div class="h-0.5 w-full bg-cobalt shadow-[0_0_10px_rgba(0,85,255,0.3)]"></div>
              </div>
              <div class="text-xs text-text-faint tracking-widest uppercase opacity-60 mb-2">// curado desde panel admin</div>
              <div class="island-wrapper min-h-[180px]">
                <div class="island-placeholder absolute inset-0 bg-carbono-surface"></div>
                <TechMatrix tools={techStack} client:only="react" />
              </div>
            </div>
          </section>

          <!-- Roadmap -->
          <section id="ambitions" class="border border-white/15 bg-carbono-surface p-3 overflow-hidden col-span-2">
            <div class="h-full overflow-y-auto">
              <div class="mb-2">
                <div class="flex items-center justify-between pb-2">
                  <span class="text-sm font-bold text-white tracking-widest">// HOJA DE RUTA</span>
                </div>
                <div class="h-0.5 w-full bg-cobalt shadow-[0_0_10px_rgba(0,85,255,0.3)]"></div>
              </div>
              <div class="island-wrapper min-h-[180px]">
                <div class="island-placeholder absolute inset-0 bg-carbono-surface"></div>
                <Roadmap ambitions={ambitions} client:only="react" />
              </div>
            </div>
          </section>
        </div>
      </main>
      
    </div>

    <!-- MOBILE: stacked -->
    <div class="lg:hidden flex-1 min-h-0 overflow-y-auto island-wrapper min-h-[500px]">
      <div class="island-placeholder absolute inset-0 bg-carbono-surface"></div>
      <CoreHome
        identityData={identityData}
        projects={projects}
        techStack={techStack}
        ambitions={ambitions}
        logs={logs}
        logLimit={settings.logLimit ?? 10}
        settings={settings}
        client:only="react"
      />
    </div>

  </div>
</BaseLayout>

<style>
  /* Scoped style for target sections scroll-margin-top */
  #deployments,
  #tech,
  #ambitions {
    scroll-margin-top: 4rem; /* clear the fixed nav */
  }

  /* CSS selector for hiding placeholders when react island loaded */
  .island-wrapper {
    position: relative;
  }
  .island-wrapper :global(astro-island) {
    display: contents;
  }
  .island-wrapper:has(astro-island:not(:empty)) .island-placeholder {
    display: none !important;
  }
</style>

<script>
  function switchLeftTab(tab: string) {
    document.querySelectorAll('#left-tabs button').forEach(b => {
      if (!(b instanceof HTMLElement)) return;
      b.classList.remove('bg-cobalt', 'text-white');
      b.classList.add('text-white/50');
      if (b.dataset.tab === tab) {
        b.classList.add('bg-cobalt', 'text-white');
        b.classList.remove('text-white/50');
      }
    });
    const profileTab = document.getElementById('tab-profile');
    const terminalTab = document.getElementById('tab-terminal');
    if (profileTab) profileTab.classList.toggle('hidden', tab !== 'profile');
    if (terminalTab) terminalTab.classList.toggle('hidden', tab !== 'terminal');
  }

  function initTabs() {
    document.querySelectorAll('#left-tabs button').forEach(b => {
      if (!(b instanceof HTMLElement)) return;
      b.addEventListener('click', () => {
        if (b.dataset.tab) {
          switchLeftTab(b.dataset.tab);
        }
      });
    });
  }

  function handleHashScroll() {
    const hash = window.location.hash;
    if (hash) {
      const target = document.querySelector(hash);
      if (target) {
        setTimeout(() => {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }, 150); // slight delay to allow React DOM mounting/render
      }
    }
  }

  // Bind to page transitions and load
  document.addEventListener('astro:page-load', () => {
    initTabs();
    handleHashScroll();
  });

  window.addEventListener('hashchange', handleHashScroll);
</script>
