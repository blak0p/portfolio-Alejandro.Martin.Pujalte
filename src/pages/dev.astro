---
import BaseLayout from '../layouts/BaseLayout.astro';
import DevTerminal from '../components/terminal/DevTerminal';
import type { TermData } from '../components/terminal/engine';
import type { LogEntry, Project, SiteSettings, TechTool } from '../types';
import { sortProjects } from '../lib/projectRanking';
import identity from '../../public/data/identity.json';
import logs from '../../public/data/logs.json';
import settings from '../../public/data/settings.json';
import techStack from '../../public/data/techstack.json';
import projectsData from '../../public/data/projects.json';
import community from '../../public/data/community.json';

const s = settings as unknown as SiteSettings;
const i = identity as any;
const logList = logs as unknown as LogEntry[];
const tools = techStack as unknown as TechTool[];
const projects = sortProjects(projectsData as unknown as Project[]);

const cvUrl = s.cvUrl ?? i.cvUrl ?? '/cv';
const cvIsPdf = /\.pdf$/i.test(cvUrl);
const email: string = s.contactEmail ?? i.contactEmail ?? '';
const photo = s.photoUrl || '/profile.jpg';
const fullName = String(i.name).replace('\n', ' ');
const host = String(i.location || 'valencia').toLowerCase();
const github: string = (i.links?.[0]?.href as string) ?? 'https://github.com/blak0p';
const githubShort = github.replace(/^https?:\/\//, '');

// ── Proyectos ───────────────────────────────────────────────────────────────
const slugOf = (name: string) => name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '') || 'module';
const CASE: Record<string, string> = {
  go: 'Go', c: 'C', css: 'CSS', html: 'HTML', javascript: 'JavaScript', typescript: 'TypeScript',
  python: 'Python', shell: 'Shell', makefile: 'Makefile', java: 'Java', astro: 'Astro', react: 'React',
  vite: 'Vite', wails: 'Wails',
};
const tech = (t: string) => CASE[t.toLowerCase()] ?? (t === t.toUpperCase() ? t.charAt(0) + t.slice(1).toLowerCase() : t);
const STATUS: Record<string, { label: string; cls: string }> = {
  COMPLETED: { label: 'COMPLETADO', cls: 'st-ok' },
  IN_PROGRESS: { label: 'EN PROGRESO', cls: 'st-wip' },
  PAUSED: { label: 'PAUSADO', cls: '' },
};

const repos = projects.map((p) => {
  const specs = p.specs as Record<string, any>;
  const repoUrl = String(specs?.repo ?? '');
  const repoName = String(specs?.repoSlug ?? '').split('/')[1] || p.name.toLowerCase();
  return {
    slug: slugOf(p.name),
    name: repoName,
    description: p.description || p.recruiterDescription || '',
    stack: (p.stack ?? []).map(tech),
    stars: parseInt(String(specs?.stars ?? '0'), 10) || 0,
    license: String(specs?.license ?? ''),
    repo: repoUrl,
    priv: !!p.isPrivate,
    status: STATUS[String(specs?.status ?? '')] ?? { label: String(specs?.status ?? ''), cls: '' },
  };
});

// ── Open source (solo título, número, repo, fecha y enlaces) ────────────────
const fmtDate = (iso: string) =>
  new Intl.DateTimeFormat('es-ES', { day: '2-digit', month: '2-digit', year: 'numeric', timeZone: 'UTC' }).format(new Date(iso));
const fmtNum = (n: number) => new Intl.NumberFormat('es-ES', { useGrouping: 'always' }).format(n);
const prs = (community.projects ?? []).flatMap((cp: any) =>
  (cp.prs ?? []).map((pr: any) => ({ ...pr, repo: `${cp.owner}/${cp.name}`, repoUrl: cp.url, stars: cp.stars })),
).sort((a: any, b: any) => +new Date(b.mergedAt) - +new Date(a.mergedAt));
const PR_VISIBLE = 3;

// ── Stack agrupado ──────────────────────────────────────────────────────────
const groups: { group: string; items: string[] }[] = [];
for (const t of tools) {
  const g = t.group || 'Otros';
  let entry = groups.find((x) => x.group === g);
  if (!entry) groups.push((entry = { group: g, items: [] }));
  entry.items.push(t.name);
}
const langs = tools.slice(0, 3).map((t) => t.name.toLowerCase()).join(', ');

// ── Datos de la terminal ────────────────────────────────────────────────────
const termData: TermData = {
  identity: { ...i, cvUrl, linkedinUrl: s.linkedinUrl ?? i.linkedinUrl, birthDate: s.birthDate ?? i.birthDate, name: fullName },
  projects: repos.map((r) => ({ slug: r.slug, name: r.name, stack: r.stack, stars: r.stars, repo: r.repo.replace(/^https?:\/\//, ''), priv: r.priv })),
  stack: groups,
  logs: logList.map((l) => ({ timestamp: l.timestamp, level: l.level, message: l.message })),
  cvUrl,
  email,
  host,
};
---

<BaseLayout
  navStyle="none"
  title={`${fullName} — /dev`}
  description={i.bio}
  handle={i.handle}
>
  <div class="devpage">
    <a class="skip" href="#dev-main">Saltar al contenido</a>
    <header class="bar">
      <span class="prompt"><span>alejandro@{host}</span>:~/dev$</span>
      <nav aria-label="Principal">
        <ul>
          <li><a href="#proyectos">proyectos</a></li>
          <li><a href="#open-source">open-source</a></li>
          <li><a href="#stack" class="notranslate" translate="no">stack</a></li>
          <li><a class="rec" href="/">← vista recruiter</a></li>
        </ul>
        <div class="lang" role="group" aria-label="Idioma">
          <button type="button" data-translate="es" lang="es">ES</button>
          <button type="button" data-translate="en" lang="en">EN</button>
        </div>
      </nav>
    </header>

    <div class="layout">
      <aside>
        <section class="panel whoami" data-module="whoami" aria-labelledby="h-who">
          <h2 id="h-who"><span class="t">// WHOAMI</span></h2>
          <img src={photo} width="340" height="340" alt="Foto de Alejandro Martín" />
          <div class="body">
            <dl class="kv">
              <dt>nombre</dt><dd>{fullName}</dd>
              <dt>handle</dt><dd>{i.handle}</dd>
              <dt>rol</dt><dd>junior backend</dd>
              <dt>base</dt><dd>{i.location} · remoto</dd>
              {langs && (<><dt>lang</dt><dd class="notranslate" translate="no">{langs}</dd></>)}
            </dl>
            <div class="cmds">
              <a class="cmd" id="mailcmd" href={`mailto:${email}`}>$ mail {email} <span aria-hidden="true">↵</span></a>
              <a class="cmd" href={github} target="_blank" rel="noopener noreferrer">$ open {githubShort} <span aria-hidden="true">↗</span></a>
              {cvIsPdf
                ? <a class="cmd" href={cvUrl} download>$ curl -O {cvUrl} <span aria-hidden="true">↓</span></a>
                : <a class="cmd" href={cvUrl} target="_blank" rel="noopener">$ open {cvUrl} <span aria-hidden="true">↗</span></a>}
            </div>
          </div>
        </section>
      </aside>

      <div class="dev-main" id="dev-main">
        <section class="panel term" aria-labelledby="h-term">
          <h2 id="h-term"><span class="t">// TERMINAL</span><small>escribe <b>help</b> o <b>help -a</b> · ↑↓ historial · Tab autocompleta</small></h2>
          <DevTerminal data={termData} client:load />
        </section>

        <section class="panel" id="proyectos" data-module="proyectos" aria-labelledby="h-proj">
          <h2 id="h-proj"><span class="t">// PROYECTOS</span><small>{repos.length} {repos.length === 1 ? 'repo' : 'repos'}</small></h2>
          {repos.map((r) => (
            <article class="repo" id={`repo-${r.slug}`}>
              <div>
                <h3 translate="no" class="notranslate">{r.name}</h3>
                <div class="meta">
                  {r.priv && <span class="tag st-priv">PRIVADO</span>}
                  {r.status.label && <span class={`tag ${r.status.cls}`}>{r.status.label}</span>}
                  {!r.priv && r.stars > 0 && <span class="stars"><span aria-hidden="true">★</span> {r.stars}<span class="sr"> estrellas</span></span>}
                  {!r.priv && r.license && <span>{r.license}</span>}
                </div>
                <p>{r.description}</p>
                {r.priv ? (
                  <div class="redacted">█ código bajo NDA</div>
                ) : r.repo ? (
                  <div class="shell notranslate" translate="no"><b>$</b> git clone {r.repo}</div>
                ) : null}
              </div>
              <ul class="techs notranslate" translate="no" aria-label="Tecnologías">
                {r.stack.map((t) => <li>{t}</li>)}
              </ul>
            </article>
          ))}
        </section>

        <section class="panel" id="open-source" data-module="open-source" aria-labelledby="h-oss">
          <h2 id="h-oss"><span class="t">// OPEN_SOURCE</span><small>{prs.length} {prs.length === 1 ? 'PR mergeado' : 'PRs mergeados'}</small></h2>
          <div class="body">
            {prs.length === 0 && <p class="empty">Todavía no hay PRs mergeados que mostrar.</p>}
            {(() => {
              const card = (pr: any) => (
              <div class="pr">
                <p class="pr-head notranslate" translate="no">{pr.repo} <span class="stars"><span aria-hidden="true">★</span> {fmtNum(pr.stars)}</span> · PR #{pr.number} · mergeado {fmtDate(pr.mergedAt)}</p>
                <p class="pr-title notranslate" translate="no">{pr.title}</p>
                <p class="pr-links">
                  <a href={pr.url} target="_blank" rel="noopener noreferrer">Ver PR #{pr.number} ↗</a> ·
                  <a href={pr.repoUrl} target="_blank" rel="noopener noreferrer">Ver repositorio ↗</a>
                </p>
              </div>
              );
              const rest = prs.slice(PR_VISIBLE);
              return (
                <>
                  {prs.slice(0, PR_VISIBLE).map(card)}
                  {rest.length > 0 && (
                    <details class="pr-more">
                      <summary>ver {rest.length} {rest.length === 1 ? 'PR más' : 'PRs más'}</summary>
                      {rest.map(card)}
                    </details>
                  )}
                </>
              );
            })()}
          </div>
        </section>

        <section class="panel stack" id="stack" data-module="stack" aria-labelledby="h-stack">
          <h2 id="h-stack"><span class="t notranslate" translate="no">// STACK</span><small>lo que uso</small></h2>
          <div class="body">
            <dl class="kv groups">
              {groups.map((g) => (<><dt>{g.group.toLowerCase()}</dt><dd class="notranslate" translate="no">{g.items.join(' · ')}</dd></>))}
            </dl>
          </div>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>

<style is:global>
  .devpage {
    --d-carbono: #0d0d0d; --d-low: #080808; --d-surface: #121212; --d-mid: #181818; --d-highest: #2a2a2a;
    --d-cobalt: #0055ff; --d-cobalt-light: #3377ff; --d-accent: #38bdf8;
    --d-text: #ffffff; --d-muted: #e2e4f0; --d-faint: #9ea4c0; --d-warn: #ffcc00; --d-err: #ff4444; --d-bronze: #d4944a;
    --d-line: rgba(255, 255, 255, 0.15);
    font-family: ui-monospace, 'SFMono-Regular', 'JetBrains Mono', Menlo, Consolas, monospace;
    font-size: 14px; line-height: 1.6; color: var(--d-muted); background: var(--d-carbono); min-height: 100vh;
  }
  .devpage *, .devpage *::before, .devpage *::after { box-sizing: border-box; }
  .devpage a { color: var(--d-accent); text-underline-offset: 3px; }
  .devpage a:focus-visible, .devpage button:focus-visible { outline: 2px solid var(--d-accent); outline-offset: 2px; }
  .devpage .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .devpage .skip { position: absolute; left: -999px; }
  .devpage .skip:focus { left: 12px; top: 12px; background: var(--d-cobalt); color: #fff; padding: 6px 10px; z-index: 20; }

  .devpage header.bar { position: sticky; top: 0; z-index: 10; min-height: 48px; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 0 24px; background: var(--d-low); border-bottom: 1px solid var(--d-line); }
  .devpage .prompt { color: var(--d-text); font-size: 13px; white-space: nowrap; }
  .devpage .prompt span { color: var(--d-accent); }
  .devpage header nav { display: flex; align-items: center; gap: 20px; }
  .devpage header nav ul { list-style: none; display: flex; gap: 20px; margin: 0; padding: 0; font-size: 13px; }
  .devpage header nav ul a { color: var(--d-faint); text-decoration: none; }
  .devpage header nav ul a:hover { color: var(--d-text); }
  .devpage header nav ul a.rec { color: var(--d-accent); }
  .devpage .lang { display: flex; }
  .devpage .lang button { font: inherit; font-size: 12px; background: transparent; color: var(--d-faint); border: 1px solid var(--d-line); padding: 2px 9px; cursor: pointer; }
  .devpage .lang button + button { border-left: 0; }
  .devpage .lang button:hover { color: var(--d-text); border-color: var(--d-cobalt-light); }

  .devpage .layout { max-width: 1360px; margin: 0 auto; padding: 24px; display: grid; grid-template-columns: 340px minmax(0, 1fr); gap: 24px; align-items: start; }
  .devpage .panel { background: var(--d-surface); border: 1px solid var(--d-line); box-shadow: inset 0 1px 0 rgba(255, 255, 255, .05), inset 0 -1px 0 rgba(0, 0, 0, .5), 0 4px 12px rgba(0, 0, 0, .5); scroll-margin-top: 72px; }
  .devpage .panel > h2 { margin: 0; padding: 12px 16px; font-size: 13px; font-weight: 500; color: var(--d-text); letter-spacing: .08em; border-bottom: 1px solid var(--d-line); display: flex; justify-content: space-between; gap: 12px; }
  .devpage .panel > h2 span.t { border-bottom: 2px solid var(--d-cobalt); padding-bottom: 2px; }
  .devpage .panel > h2 small { color: var(--d-faint); font-weight: 400; letter-spacing: 0; }
  .devpage .term h2 small b { color: var(--d-text); font-weight: 500; }
  .devpage .body { padding: 16px; }

  .devpage aside { position: sticky; top: 72px; display: flex; flex-direction: column; gap: 24px; }
  .devpage .whoami img { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; display: block; border-bottom: 1px solid var(--d-line); }
  .devpage .kv { display: grid; grid-template-columns: 90px 1fr; gap: 4px 12px; font-size: 13px; margin: 0; }
  .devpage .kv dt { color: var(--d-faint); }
  .devpage .kv dd { margin: 0; color: var(--d-text); overflow-wrap: anywhere; }
  .devpage .cmds { display: flex; flex-direction: column; gap: 8px; margin-top: 16px; }
  .devpage .cmd { display: flex; justify-content: space-between; gap: 8px; padding: 8px 12px; border: 1px solid var(--d-line); color: var(--d-text); text-decoration: none; font-size: 13px; overflow-wrap: anywhere; }
  .devpage .cmd:hover { border-color: var(--d-cobalt-light); background: var(--d-mid); }
  .devpage .cmd span { color: var(--d-faint); }
  .devpage .cmd.pulse { outline: 2px solid var(--d-accent); outline-offset: 2px; background: var(--d-mid); }

  .devpage .dev-main { display: flex; flex-direction: column; gap: 24px; min-width: 0; }
  .devpage .repo { padding: 20px; border-bottom: 1px solid var(--d-line); display: grid; grid-template-columns: minmax(0, 1fr) 260px; gap: 24px; scroll-margin-top: 72px; }
  .devpage .repo:last-child { border-bottom: 0; }
  .devpage .repo h3 { margin: 0 0 4px; color: var(--d-text); font-size: 18px; font-weight: 600; }
  .devpage .repo .meta { display: flex; gap: 14px; flex-wrap: wrap; font-size: 12px; color: var(--d-faint); margin-bottom: 10px; }
  .devpage .stars { color: var(--d-bronze); }
  .devpage .tag { padding: 1px 8px; border: 1px solid var(--d-line); }
  .devpage .tag.st-ok { color: var(--d-accent); border-color: rgba(56, 189, 248, .4); }
  .devpage .tag.st-wip { color: var(--d-warn); border-color: rgba(255, 204, 0, .4); }
  .devpage .tag.st-priv { color: var(--d-err); border-color: rgba(255, 68, 68, .45); }
  .devpage .repo p { margin: 0 0 12px; }
  .devpage .shell { background: var(--d-low); border: 1px solid var(--d-line); padding: 10px 12px; font-size: 12.5px; overflow-x: auto; white-space: nowrap; color: var(--d-muted); }
  .devpage .shell b { color: var(--d-accent); font-weight: 400; }
  .devpage .techs { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; align-content: flex-start; font-size: 12px; }
  .devpage .techs li { padding: 2px 8px; border: 1px solid var(--d-line); color: var(--d-muted); }
  .devpage .redacted { background: repeating-linear-gradient(45deg, rgba(255, 68, 68, .15) 0 8px, transparent 8px 16px); border: 1px solid rgba(255, 68, 68, .35); padding: 10px 12px; font-size: 12.5px; color: var(--d-muted); }
  .devpage .repo.hl { outline: 2px solid var(--d-accent); outline-offset: -2px; background: var(--d-mid); }

  .devpage .pr { margin-bottom: 16px; }
  .devpage .pr:last-child { margin-bottom: 0; }
  .devpage .pr-more { margin-top: 16px; }
  .devpage .pr-more > summary { cursor: pointer; color: var(--d-text); font-family: inherit; }
  .devpage .pr-more > summary:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }
  .devpage .pr-more[open] > summary { margin-bottom: 16px; }
  .devpage .pr p { margin: 0; }
  .devpage .pr-head { color: var(--d-text); margin-bottom: 4px !important; }
  .devpage .pr-title { margin-bottom: 12px !important; }
  .devpage .empty { margin: 0; color: var(--d-faint); }

  .devpage .groups { grid-template-columns: 90px 1fr; gap: 10px 12px; }

  .devpage .panel > h2 span.t { white-space: nowrap; }
  .devpage .panel > h2 { flex-wrap: wrap; }

  @media (max-width: 1000px) {
    .devpage .layout { grid-template-columns: minmax(0, 1fr); padding: 16px; }
    .devpage aside { position: static; }
    .devpage .whoami img { aspect-ratio: auto; height: 220px; }
    .devpage .repo { grid-template-columns: minmax(0, 1fr); }
    .devpage header.bar { padding: 8px 16px; flex-wrap: wrap; }
    .devpage header nav ul li:not(:last-child) { display: none; }
  }

  .devpage .gone { opacity: 0; visibility: hidden; }
  @media (prefers-reduced-motion: no-preference) {
    .devpage .gone { transition: opacity .8s ease-in, visibility 0s linear .8s; }
    @keyframes dev-glitch {
      0% { transform: translate(0, 0); text-shadow: 2px 0 var(--d-err), -2px 0 var(--d-cobalt-light); }
      50% { transform: translate(-2px, 1px); text-shadow: -2px 0 var(--d-err), 2px 0 var(--d-cobalt-light); }
      100% { transform: translate(2px, -1px); text-shadow: 2px 0 var(--d-cobalt-light), -2px 0 var(--d-err); }
    }
    body.dev-glitch .devpage .dev-main, body.dev-glitch .devpage aside { animation: dev-glitch .25s steps(2) infinite; }
  }
</style>
