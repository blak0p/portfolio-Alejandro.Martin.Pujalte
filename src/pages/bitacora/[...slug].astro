---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/gitbook/Sidebar.astro';
import { getAllSlugs, getSidebarMenu, getPageContent } from '../../lib/gitbook';

export const prerender = true;

export async function getStaticPaths() {
  const slugs = getAllSlugs();
  return slugs.map((slug) => ({
    params: { slug: slug === '' ? undefined : slug },
  }));
}

const { slug } = Astro.params;
const prefix = '/bitacora';

const page = await getPageContent(slug, prefix);
if (!page) {
  return Astro.redirect('/404');
}

const menu = await getSidebarMenu(prefix);
const externalUrl = 'https://blak0p.gitbook.io/bitacora';
const currentPath = Astro.url.pathname;
---

<BaseLayout title={`${page.title} — Bitácora`} navStyle="recruiter">
  <div class="w-full px-4 sm:px-6 lg:px-8 py-8">
    <div class="grid grid-cols-1 md:grid-cols-[240px_1fr] gap-8">
      <!-- Sidebar Column -->
      <aside class="md:sticky md:top-20 md:h-[calc(100vh-6rem)] overflow-y-auto">
        <Sidebar
          menu={menu}
          currentPath={currentPath}
          externalUrl={externalUrl}
          navStyle="recruiter"
        />
      </aside>

      <!-- Content Column -->
      <article class="min-w-0">
        <div class="bg-white/[0.03] border border-white/10 rounded-lg p-6 md:p-8">
          <div class="gitbook-content" set:html={page.html} />
        </div>
      </article>
    </div>
  </div>
</BaseLayout>

<style is:global>
  /* Recruiter/Sans styles for GitBook Content */
  .gitbook-content {
    font-size: 0.875rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.8);
  }

  .gitbook-content h1 {
    font-size: 1.5rem;
    font-weight: 700;
    color: #ffffff;
    margin-top: 0;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    padding-bottom: 0.5rem;
  }

  .gitbook-content h2 {
    font-size: 1.2rem;
    font-weight: 600;
    color: #ffffff;
    margin-top: 2rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    padding-bottom: 0.25rem;
  }

  .gitbook-content h3 {
    font-size: 1.05rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.9);
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .gitbook-content p {
    margin-top: 0;
    margin-bottom: 1rem;
  }

  .gitbook-content a {
    color: var(--color-recruiter-accent-light, #38BDF8);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 150ms ease;
  }

  .gitbook-content a:hover {
    color: #ffffff;
  }

  .gitbook-content ul,
  .gitbook-content ol {
    margin-top: 0;
    margin-bottom: 1rem;
    padding-left: 1.5rem;
  }

  .gitbook-content li {
    margin-bottom: 0.25rem;
  }

  .gitbook-content code {
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
    padding: 0.15em 0.35em;
    border-radius: 4px;
    font-family: var(--font-mono), monospace;
    font-size: 0.8em;
  }

  .gitbook-content pre {
    background: rgba(0, 0, 0, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    padding: 1rem;
    overflow-x: auto;
    margin-top: 0;
    margin-bottom: 1.5rem;
  }

  .gitbook-content pre code {
    background: transparent;
    padding: 0;
    border-radius: 0;
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.9);
  }

  .gitbook-content blockquote {
    margin: 1.5rem 0;
    padding: 0.5rem 1rem;
    border-left: 3px solid var(--color-recruiter-accent, #0066FF);
    background: rgba(255, 255, 255, 0.02);
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    color: rgba(255, 255, 255, 0.7);
  }

  .gitbook-content img {
    max-width: 100%;
    height: auto;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.05);
    margin: 1.5rem 0;
  }

  .gitbook-content table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.8rem;
  }

  .gitbook-content th {
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 0.5rem;
    background: rgba(255, 255, 255, 0.05);
    text-align: left;
    font-weight: 600;
  }

  .gitbook-content td {
    border: 1px solid rgba(255, 255, 255, 0.05);
    padding: 0.5rem;
  }

  .gitbook-content hr {
    border: none;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    margin: 2rem 0;
  }
</style>
