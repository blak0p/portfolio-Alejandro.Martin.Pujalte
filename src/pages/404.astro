---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Página no encontrada" navStyle="none">
  <main id="main" class="min-h-screen bg-[#080c14] text-[#e2e4f0] font-sans flex items-center justify-center px-6">
    <div class="flex flex-col items-start gap-4 max-w-md">
      <p class="text-sm tracking-widest uppercase text-[#9ea4c0] font-mono">Error 404</p>
      <h1 class="text-3xl font-bold text-white">Esta página no existe.</h1>
      <p class="text-[#9ea4c0]">Puede que el enlace esté mal o que ya no esté disponible.</p>
      <a href="/" class="mt-2 inline-flex rounded-full bg-[#0066FF] px-5 py-2.5 font-semibold text-white hover:bg-[#0033AA] focus-visible:outline-2 focus-visible:outline-[#38BDF8]">Volver al inicio</a>
    </div>
  </main>
</BaseLayout>
