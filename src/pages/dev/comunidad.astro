---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CommunityGrid from '../../components/community/dev/CommunityGrid';
import { loadCommunity } from '../../lib/community-data';

// SSR: community.json is generated by the cron and may be absent on first
// deploys. loadCommunity() returns the empty shape in that case (never throws).
export const prerender = false;

const data = loadCommunity();
const projects = data.projects;
const totalMerged = data.totalMerged;
---

<BaseLayout
  title={`Comunidad — Alejandro Martin Pujalte (DEV)`}
  description={`Contribuciones OSS: ${totalMerged} PRs merged across ${projects.length} repos.`}
  navStyle="dev"
>
  <div class="w-full px-4 sm:px-6 lg:px-8 py-6 font-mono">
    <section id="comunidad" class="border border-white/15 bg-carbono-surface p-3 sharp-corner">
      <div class="mb-3 shrink-0">
        <div class="flex items-center justify-between pb-2">
          <span class="text-sm font-bold text-white tracking-widest">// COMUNIDAD</span>
          <span class="text-xs text-text-faint tracking-widest uppercase">
            {totalMerged} PR · {projects.length} REPOS
          </span>
        </div>
        <div class="h-0.5 w-full bg-cobalt shadow-[0_0_10px_rgba(0,85,255,0.3)]"></div>
      </div>

      <div class="island-wrapper min-h-[250px]">
        <div class="island-placeholder absolute inset-0 bg-carbono-surface"></div>
        <CommunityGrid projects={projects} client:only="react" />
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  #comunidad {
    scroll-margin-top: 4rem;
  }
  .island-wrapper {
    position: relative;
  }
  .island-wrapper :global(astro-island) {
    display: contents;
  }
  .island-wrapper:has(astro-island:not(:empty)) .island-placeholder {
    display: none !important;
  }
</style>