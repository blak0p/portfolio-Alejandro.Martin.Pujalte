---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/recruiter/Hero.astro';
import About from '../components/recruiter/About.astro';
import Projects from '../components/recruiter/Projects';
import Tech from '../components/recruiter/Tech.astro';
import Contact from '../components/recruiter/Contact.astro';
import identity from '../../public/data/identity.json';
import settings from '../../public/data/settings.json';
import projects from '../../public/data/projects.json';
import ambitions from '../../public/data/ambitions.json';
import techStack from '../../public/data/techstack.json';
import Roadmap from '../components/recruiter/Roadmap.astro';

// Merge identity with settings (settings override identity for dynamic values)
const identityData = {
  ...identity,
  status: settings.status ?? identity.status,
  availabilityValue: settings.availabilityValue ?? identity.availabilityValue,
  cvUrl: settings.cvUrl ?? identity.cvUrl,
  linkedinUrl: settings.linkedinUrl ?? identity.linkedinUrl,
  birthDate: settings.birthDate ?? (identity as any).birthDate,
  bio: settings.bio ?? identity.bio,
  photoUrl: settings.photoUrl ?? (identity as any).photoUrl ?? '/profile.jpg',
};

const heroPhotoUrl: string = identityData.photoUrl;
const recruiterBio: string = identityData.bio;
const recruiterCvUrl: string = identityData.cvUrl;
const recruiterLinkedinUrl: string = identityData.linkedinUrl;

// Load and map all projects (both public and private) with description fallback
const recruiterProjects = projects.map((p: any) => ({
  ...p,
  description: p.description || p.specs?.description || '',
}));

// Load and map all technical tools with their usage levels
const recruiterTech = techStack.map((t: any) => ({
  name: t.name,
  version: t.version || undefined,
  usageLevel: typeof t.usageLevel === 'number' ? t.usageLevel : 0,
}));
---

<BaseLayout
  title={`${identityData.name.replace('\n', ' ')} — Backend Developer`}
  description={recruiterBio}
  handle={identityData.handle}
  status={identityData.status}
  navStyle="recruiter"
>
  <div class="warm-bg">
    <Hero
      name={identityData.name}
      handle={identityData.handle}
      status={identityData.status}
      photo={heroPhotoUrl}
      email={identityData.contactEmail}
      linkedin={recruiterLinkedinUrl}
      github={identityData.links.find((l: any) => l.label.includes('GITHUB'))?.href || 'https://github.com/blak0p'}
    />

    <main class="flex flex-col gap-16 pb-20 recruiter-reveal-root">
      <About
        bio={recruiterBio}
        birthDate={identityData.birthDate}
        availabilityValue={identityData.availabilityValue}
        cvUrl={recruiterCvUrl}
        linkedinUrl={recruiterLinkedinUrl}
        email={identityData.contactEmail}
        github={identityData.links.find((l: any) => l.label.includes('GITHUB'))?.href || 'https://github.com/blak0p'}
      />

      <Projects projects={recruiterProjects} client:load />

      <Tech tools={recruiterTech} />

      <Roadmap ambitions={ambitions} roadmapLabels={settings.roadmapLabels} />
    </main>
  </div>
</BaseLayout>

<style is:global>
  /* Smooth scroll for anchor nav */
  html {
    scroll-behavior: smooth;
  }

  /* Warm page background fallback (sits under the hero gradient) */
  .warm-bg {
    background-color: #080c14;
  }

  /* Section layout shared by all recruiter sections */
  .recruiter-section {
    padding-top: 1rem;
    scroll-margin-top: 4rem; /* clear the fixed nav */
  }

  .recruiter-container {
    max-width: 56rem; /* ~896px — readable single column */
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .recruiter-section-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 1.5rem;
  }

  /* Fade-in reveal on scroll (Intersection Observer adds .visible) */
  .recruiter-section {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }
  .recruiter-section.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Respect reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .recruiter-section {
      opacity: 1;
      transform: none;
      transition: none;
    }
    html {
      scroll-behavior: auto;
    }
    .recruiter-gradient-bg {
      animation: none;
    }
  }
</style>

<script>
  // Fade-in section reveal + hero parallax — vanilla JS, no libraries.
  // Runs once on page load and on Astro view transitions.
  function initRecruiterAnimations() {
    const sections = document.querySelectorAll('.recruiter-section');
    if ('IntersectionObserver' in window) {
      const reveal = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              reveal.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
      );
      sections.forEach((s) => reveal.observe(s));
    } else {
      sections.forEach((s) => s.classList.add('visible'));
    }

    // Hero parallax — translate the photo layer based on scroll position.
    const parallax = document.querySelector('.recruiter-parallax');
    if (parallax && 'IntersectionObserver' in window) {
      let ticking = false;
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          const y = window.scrollY;
          if (y < 600) {
            (parallax as HTMLElement).style.transform = `translateY(${y * 0.25}px)`;
          }
          ticking = false;
        });
      };
      window.addEventListener('scroll', onScroll, { passive: true });
    }
  }

  initRecruiterAnimations();
  document.addEventListener('astro:page-load', initRecruiterAnimations);
</script>