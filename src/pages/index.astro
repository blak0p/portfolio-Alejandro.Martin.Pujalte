---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/recruiter/Hero.astro';
import About from '../components/recruiter/About.astro';
import Projects from '../components/recruiter/Projects.astro';
import Tech from '../components/recruiter/Tech.astro';
import Contact from '../components/recruiter/Contact.astro';
import identity from '../../public/data/identity.json';
import settings from '../../public/data/settings.json';
import projects from '../../public/data/projects.json';
import techStack from '../../public/data/techstack.json';

// Merge identity with settings (settings override identity for dynamic values)
const identityData = {
  ...identity,
  status: settings.status ?? identity.status,
  availabilityValue: settings.availabilityValue ?? identity.availabilityValue,
  cvUrl: settings.cvUrl ?? identity.cvUrl,
  linkedinUrl: settings.linkedinUrl ?? identity.linkedinUrl,
  birthDate: settings.birthDate ?? (identity as any).birthDate,
};

// Recruiter-facing project view: show ALL projects (including private),
// strip internal fields. No "privado" labels — all projects look equal.
const visibleProjects = (projects as any[]).map((p) => ({
  name: p.name,
  photo: p.photo,
  description: p.description || p.specs?.description,
  stack: Array.isArray(p.stack) ? p.stack : [],
  repo: p.specs?.repo ?? p.repo,
}));
---

<BaseLayout
  title={`${identityData.name.replace('\n', ' ')} — Backend Developer`}
  description={identityData.bio}
  handle={identityData.handle}
  status={identityData.status}
  navStyle="recruiter"
>
  <div class="warm-bg">
    <Hero
      name={identityData.name}
      handle={identityData.handle}
      status={identityData.status}
    />

    <main class="flex flex-col gap-16 pb-20 recruiter-reveal-root">
      <About
        bio={identityData.bio}
        birthDate={identityData.birthDate}
        availabilityValue={identityData.availabilityValue}
        cvUrl={identityData.cvUrl}
        linkedinUrl={identityData.linkedinUrl}
      />

      <Projects projects={visibleProjects} />

      <Tech tools={techStack} />

      <Contact
        contactEmail={identityData.contactEmail}
        links={identityData.links}
        linkedinUrl={identityData.linkedinUrl}
      />
    </main>
  </div>
</BaseLayout>

<style is:global>
  /* Smooth scroll for anchor nav */
  html {
    scroll-behavior: smooth;
  }

  /* Warm page background fallback (sits under the hero gradient) */
  .warm-bg {
    background-color: #0d0d0d;
  }

  /* Section layout shared by all recruiter sections */
  .recruiter-section {
    padding-top: 1rem;
    scroll-margin-top: 4rem; /* clear the fixed nav */
  }

  .recruiter-container {
    max-width: 56rem; /* ~896px — readable single column */
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .recruiter-section-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 1.5rem;
  }

  /* Fade-in reveal on scroll (Intersection Observer adds .visible) */
  .recruiter-section {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }
  .recruiter-section.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Respect reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .recruiter-section {
      opacity: 1;
      transform: none;
      transition: none;
    }
    html {
      scroll-behavior: auto;
    }
    .recruiter-gradient-bg {
      animation: none;
    }
  }
</style>

<script>
  // Fade-in section reveal + hero parallax — vanilla JS, no libraries.
  // Runs once on page load and on Astro view transitions.
  function initRecruiterAnimations() {
    const sections = document.querySelectorAll('.recruiter-section');
    if ('IntersectionObserver' in window) {
      const reveal = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              reveal.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
      );
      sections.forEach((s) => reveal.observe(s));
    } else {
      sections.forEach((s) => s.classList.add('visible'));
    }

    // Hero parallax — translate the photo layer based on scroll position.
    const parallax = document.querySelector('.recruiter-parallax');
    if (parallax && 'IntersectionObserver' in window) {
      let ticking = false;
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          const y = window.scrollY;
          if (y < 600) {
            (parallax as HTMLElement).style.transform = `translateY(${y * 0.25}px)`;
          }
          ticking = false;
        });
      };
      window.addEventListener('scroll', onScroll, { passive: true });
    }
  }

  initRecruiterAnimations();
  document.addEventListener('astro:page-load', initRecruiterAnimations);
</script>