---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../components/recruiter/recruiter.css';
import type { SiteSettings } from '../types';
import identity from '../../public/data/identity.json';
import settings from '../../public/data/settings.json';
import projects from '../../public/data/projects.json';
import techStack from '../../public/data/techstack.json';
import community from '../../public/data/community.json';

const s = settings as unknown as SiteSettings;
const i = identity as any;

const name: string = i.name.replace('\n', ' ');
const photo: string = s.photoUrl || i.photoUrl || '/profile.jpg';
const cvUrl: string = s.cvUrl ?? i.cvUrl;
const linkedinUrl: string = s.linkedinUrl ?? i.linkedinUrl;
const githubUrl: string = i.links?.find((l: any) => /github/i.test(l.label))?.href ?? 'https://github.com/blak0p';
const email: string = i.contactEmail;
const location: string = i.location || 'Valencia';

const birth = new Date(s.birthDate ?? i.birthDate);
const now = new Date();
let age = now.getFullYear() - birth.getFullYear();
if (now < new Date(now.getFullYear(), birth.getMonth(), birth.getDate())) age--;

const STACK_LABELS: Record<string, string> = {
  GO: 'Go', C: 'C', PYTHON: 'Python', SHELL: 'Shell', MAKEFILE: 'Makefile', WAILS: 'Wails', REACT: 'React',
  VITE: 'Vite', ASTRO: 'Astro', TYPESCRIPT: 'TypeScript', JAVASCRIPT: 'JavaScript', CSS: 'CSS', JAVA: 'Java',
};
const pretty = (t: string) => STACK_LABELS[t.toUpperCase()] ?? (t === t.toUpperCase() ? t.charAt(0) + t.slice(1).toLowerCase() : t);
const prettyName = (n: string) =>
  n !== n.toUpperCase() ? n : n.split(' ').map((w) => (/\d/.test(w) ? w : w.toLowerCase())).join(' ').replace(/^./, (c) => c.toUpperCase());
const STATUS: Record<string, string> = { COMPLETED: 'Completado', IN_PROGRESS: 'En progreso', PAUSED: 'Pausado' };
const num = (n: number) => String(n).replace(/\B(?=(\d{3})+(?!\d))/g, '.');
const fmtDate = (d: string) => {
  const t = new Date(d);
  return `${String(t.getUTCDate()).padStart(2, '0')}/${String(t.getUTCMonth() + 1).padStart(2, '0')}/${t.getUTCFullYear()}`;
};

const cases = (projects as any[]).map((p, idx) => {
  const sp = p.specs ?? {};
  const isPrivate = !!p.isPrivate;
  return {
    n: String(idx + 1).padStart(2, '0'),
    title: prettyName(p.name),
    isPrivate,
    stars: !isPrivate && Number(sp.stars) > 0 ? sp.stars : '',
    status: STATUS[sp.status] ?? '',
    stack: (p.stack ?? []).slice(0, 4).map(pretty).join(' · '),
    description: p.description || sp.description || '',
    problem: p.problem as string | undefined,
    solution: p.solution as string | undefined,
    repo: !isPrivate ? (sp.repo as string | undefined) : undefined,
  };
});

const prs = (community.projects as any[])
  .filter((c) => c.active !== false)
  .flatMap((c) => (c.prs ?? []).map((pr: any) => ({ ...pr, repo: `${c.owner}/${c.name}`, repoUrl: c.url, stars: c.stars })))
  .sort((a, b) => String(b.mergedAt).localeCompare(String(a.mergedAt)));
const PR_VISIBLE = 3;

const groups = new Map<string, string[]>();
for (const t of techStack as any[]) {
  const g = t.group || 'Otros';
  groups.set(g, [...(groups.get(g) ?? []), t.name]);
}

const toc = [
  ['contacto', 'Contacto'], ['proyectos', 'Proyectos'], ['open-source', 'Open source'], ['stack', 'Stack'],
];
---

<BaseLayout
  title={`${name} — Desarrollador backend junior`}
  description={`Desarrollador backend junior en ${location}. Go, infraestructura de IA local y herramientas para desarrolladores. Busco mi primer puesto, en remoto o en ${location}.`}
  handle={i.handle}
  navStyle="recruiter"
>
  <div class="rc">
    <a class="skip" href="#main">Saltar al contenido</a>
    <div class="layout">
      <aside class="side" aria-label="Perfil">
        <img class="avatar" src={photo} width="96" height="96" alt={`Foto de ${name}`} />
        <p class="name">{name}</p>
        <p class="role">Junior backend developer</p>
        <span class="status"><i aria-hidden="true"></i>Disponible · {location} o remoto</span>
        <nav class="toc" aria-label="Secciones">
          <ul>
            {toc.map(([id, label], k) => (
              <li><a href={`#${id}`} aria-current={k === 0 ? 'true' : undefined} translate={id === 'stack' ? 'no' : undefined} class={id === 'stack' ? 'notranslate' : undefined}>{label}</a></li>
            ))}
          </ul>
        </nav>
        <div class="socials">
          <div class="lang" role="group" aria-label="Idioma">
            <button type="button" data-translate="es" aria-label="Español" aria-pressed="true">ES</button>
            <button type="button" data-translate="en" aria-label="English" aria-pressed="false">EN</button>
          </div>
          <a class="devlink" href="/dev">¿Eres dev? /dev →</a>
        </div>
      </aside>

      <main id="main">
        <section id="contacto" class="contact-top" aria-labelledby="h-contact">
          <div>
            <h2 id="h-contact">Contacto</h2>
            <p>¿Buscas un junior backend? Hablemos.</p>
          </div>
          <div class="ctas">
            <a class="btn btn-primary" href={`mailto:${email}`}>{email}</a>
            <a class="btn btn-ghost" href={linkedinUrl} target="_blank" rel="noopener noreferrer">LinkedIn</a>
            <a class="btn btn-ghost" href={githubUrl} target="_blank" rel="noopener noreferrer">GitHub</a>
            <a class="btn btn-ghost" href={cvUrl} download>Descargar CV</a>
          </div>
        </section>

        <div class="hero">
          <h1>Construyo sistemas que <em>aguantan bajo presión</em>.</h1>
          <p class="lede">Desarrollador backend de {age} años, centrado en Go, infraestructura de IA local y herramientas para desarrolladores.</p>
          <p>Pregunto por qué antes de preguntar cómo. Ahí empieza el verdadero trabajo.</p>
          <div class="facts">
            <div><b>Go</b>lenguaje principal</div>
            {prs.length > 0 && <div><b>{prs.length === 1 ? 'PR mergeado' : `${prs.length} PR mergeados`}</b>en {prs[0].repo.split('/')[1]}</div>}
            <div><b>Junior backend</b>{location} o remoto</div>
          </div>
        </div>

        <section id="proyectos" aria-labelledby="h-proj">
          <h2 id="h-proj">Proyectos</h2>
          {cases.map((c) => (
            <article class="case">
              <span class="num">{c.n}</span>
              <div>
                <h3><span translate="no" class="notranslate">{c.title}</span>{c.isPrivate && <> <span class="private">Privado</span></>}</h3>
                <div class="meta">
                  {c.stars && <span class="stars">{c.stars} ★</span>}
                  {c.status && <span>{c.status}</span>}
                  {c.stack && <span translate="no" class="notranslate">{c.stack}</span>}
                </div>
                {c.description && <p>{c.description}</p>}
                {(c.problem || c.solution) && (
                  <dl>
                    {c.problem && <><dt>Problema</dt><dd>{c.problem}</dd></>}
                    {c.solution && <><dt>Solución</dt><dd>{c.solution}</dd></>}
                  </dl>
                )}
                {c.repo && <div class="links"><a href={c.repo} target="_blank" rel="noopener noreferrer">Repositorio →</a></div>}
              </div>
            </article>
          ))}
        </section>

        <section id="open-source" aria-labelledby="h-oss">
          <h2 id="h-oss">Open source</h2>
          {prs.length === 0 && <p>Sin contribuciones para mostrar todavía.</p>}
          {(() => {
            const card = (pr: any) => (
            <div class="oss">
              <span class="repo"><span translate="no" class="notranslate">{pr.repo}</span>{pr.stars ? ` · ${num(pr.stars)} ★` : ''} · mergeado {fmtDate(pr.mergedAt)}</span>
              <h3 translate="no" class="notranslate">{pr.title}</h3>
              <div class="links">
                <a href={pr.url} target="_blank" rel="noopener noreferrer">Ver PR #{pr.number} →</a>
                <a href={pr.repoUrl} target="_blank" rel="noopener noreferrer">Ver repositorio →</a>
              </div>
            </div>
            );
            const rest = prs.slice(PR_VISIBLE);
            return (
              <>
                {prs.slice(0, PR_VISIBLE).map(card)}
                {rest.length > 0 && (
                  <details class="oss-more">
                    <summary>Ver {rest.length} {rest.length === 1 ? 'PR más' : 'PRs más'}</summary>
                    {rest.map(card)}
                  </details>
                )}
              </>
            );
          })()}
        </section>

        <section id="stack" aria-labelledby="h-stack">
          <h2 id="h-stack"><span translate="no" class="notranslate">Stack</span></h2>
          <dl class="stack">
            {[...groups].map(([g, items]) => <div><dt>{g}</dt><dd translate="no" class="notranslate">{items.join(' · ')}</dd></div>)}
          </dl>
        </section>
      </main>
    </div>
  </div>
</BaseLayout>

<script>
  // Highlight the index entry of the section currently in view.
  function initToc() {
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('nav.toc a'));
    if (!links.length || !('IntersectionObserver' in window)) return;
    const byId = new Map(links.map((a) => [a.getAttribute('href')!.slice(1), a]));
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          links.forEach((a) => a.removeAttribute('aria-current'));
          byId.get(e.target.id)?.setAttribute('aria-current', 'true');
        }
      },
      { rootMargin: '-20% 0px -70% 0px' }
    );
    byId.forEach((_, id) => { const el = document.getElementById(id); if (el) io.observe(el); });
  }
  document.addEventListener('astro:page-load', initToc);
</script>
