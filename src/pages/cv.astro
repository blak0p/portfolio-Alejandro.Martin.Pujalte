---
// One-page CV rendered from the same data as the portfolio.
// Projects come from projects.json (recruiterDescription / recruiterStack);
// everything else lives in cv.json. The browser saves it as PDF (Ctrl+P).
import identity from '../../public/data/identity.json';
import settings from '../../public/data/settings.json';
import projectsData from '../../public/data/projects.json';
import cv from '../../public/data/cv.json';

export const prerender = true;

const i = identity as any;
const s = settings as any;

const name: string = String(i.name).replace('\n', ' ');
const email: string = i.contactEmail;
const location: string = (cv as any).location || i.location || 'Valencia';
const linkedinUrl: string = s.linkedinUrl ?? i.linkedinUrl;
const githubUrl: string = i.links?.find((l: any) => /github/i.test(l.label))?.href ?? 'https://github.com/blak0p';
const siteUrl = new URL(Astro.site ?? 'https://www.alejandro-m-p.com');
const siteHost = siteUrl.host.replace(/^www\./, '');


const STACK_LABELS: Record<string, string> = {
  GO: 'Go', C: 'C', PYTHON: 'Python', SHELL: 'Shell', MAKEFILE: 'Makefile', WAILS: 'Wails', REACT: 'React',
  VITE: 'Vite', ASTRO: 'Astro', TYPESCRIPT: 'TypeScript', JAVASCRIPT: 'JavaScript', CSS: 'CSS', JAVA: 'Java',
};

const projects = (projectsData as any[])
  .filter((p) => !p.isPrivate)
  .sort((a, b) => (a.order ?? 0) - (b.order ?? 0))
  .slice(0, cv.maxProjects ?? 4)
  .map((p) => {
    const stack: string[] = p.recruiterStack?.length
      ? p.recruiterStack
      : (p.stack ?? []).slice(0, 3).map((t: string) => STACK_LABELS[t] ?? t);
    const stars = Number(p.specs?.stars ?? 0);
    return {
      name: (p.specs?.repoSlug?.split('/')[1] ?? p.name).toString(),
      repo: p.specs?.repo || '',
      line: p.recruiterDescription || p.description || '',
      stack: stack.join(', '),
      stars: stars > 0 ? `${stars}★` : '',
    };
  });

const fileTitle = `${name.replace(/\s+/g, '-')}-CV`;
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>{fileTitle}</title>
  <style is:global>
    /* Zero page margin leaves no room for the browser's date/URL header and footer. */
    @page { size: A4; margin: 0; }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { background: #e9e9e9; }
    body { font-family: "Inter", "Helvetica Neue", Arial, sans-serif; font-size: 9.6pt; line-height: 1.42; color: #1a1a1a; }
    a { color: inherit; text-decoration: none; }
    .sheet { background: #fff; width: 210mm; min-height: 297mm; margin: 24px auto; padding: 16mm 17mm; box-shadow: 0 2px 16px rgba(0,0,0,.12); }
    .toolbar { position: fixed; top: 16px; right: 16px; display: flex; gap: 8px; }
    .toolbar button, .toolbar a { font: 600 13px/1 system-ui, sans-serif; padding: 10px 14px; border-radius: 6px; border: 1px solid #1a1a1a; background: #1a1a1a; color: #fff; cursor: pointer; }
    .toolbar a { background: #fff; color: #1a1a1a; }
    header { border-bottom: 1.5px solid #1a1a1a; padding-bottom: 9px; margin-bottom: 13px; }
    h1 { font-size: 21pt; font-weight: 700; letter-spacing: -0.3px; }
    .role { font-size: 10.5pt; color: #444; margin-top: 1px; }
    .contact { list-style: none; display: flex; flex-wrap: wrap; gap: 2px 18px; margin-top: 7px; font-size: 8.8pt; color: #333; }
    .contact li { white-space: nowrap; }
    .contact .lnk { border-bottom: 1px solid #bbb; }
    .contact .lnk::after { content: " ↗"; font-size: 7.5pt; color: #888; }
    section { margin-bottom: 12px; }
    h2 { font-size: 8.4pt; font-weight: 700; letter-spacing: 1.4px; text-transform: uppercase; color: #555; margin-bottom: 6px; }
    .row { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
    .title { font-weight: 700; font-size: 10pt; }
    .meta { font-size: 8.6pt; color: #666; white-space: nowrap; }
    .sub { font-size: 8.8pt; color: #555; }
    .item { margin-bottom: 9px; }
    .item:last-child { margin-bottom: 0; }
    .grid { display: grid; grid-template-columns: 104px 1fr; row-gap: 3px; }
    .grid dt { font-weight: 600; color: #333; }
    .proj { grid-template-columns: 124px 1fr; }
    .proj dt { font-weight: 700; color: #1a1a1a; }
    .proj dd { margin-bottom: 4px; }
    .proj .tech { color: #666; font-size: 8.6pt; }
    @media screen and (max-width: 820px) {
      .sheet { width: auto; min-height: 0; margin: 0; padding: 20px; box-shadow: none; }
      .toolbar { position: static; justify-content: flex-end; padding: 12px 20px 0; }
    }
    @media print {
      html { background: #fff; }
      .sheet { width: auto; min-height: 0; margin: 0; padding: 16mm 17mm; box-shadow: none; }
      .toolbar { display: none; }
    }
  </style>
</head>
<body>
  <div class="toolbar">
    <a href="/">← Portfolio</a>
    <button type="button" id="print">Guardar como PDF</button>
  </div>
  <main class="sheet">
    <header>
      <h1>{name}</h1>
      <div class="role">{cv.headline}</div>
      <ul class="contact">
        <li>{location}</li>
        <li><a href={`mailto:${email}`}>{email}</a></li>
        <li><a class="lnk" href={siteUrl.href}>Portfolio</a></li>
        <li><a class="lnk" href={githubUrl}>GitHub</a></li>
        <li><a class="lnk" href={linkedinUrl}>LinkedIn</a></li>
      </ul>
    </header>

    <section>
      <h2>Perfil</h2>
      <p>{cv.summary}</p>
    </section>

    {projects.length > 0 && (
      <section>
        <div class="row"><h2>Proyectos</h2><span class="meta">Detalle → {siteHost}</span></div>
        <dl class="grid proj">
          {projects.map((p) => (
            <>
              <dt>{p.repo ? <a href={p.repo}>{p.name}</a> : p.name}</dt>
              <dd>{p.line}{(p.stack || p.stars) && <div class="tech">{[p.stack, p.stars].filter(Boolean).join(' · ')}</div>}</dd>
            </>
          ))}
        </dl>
      </section>
    )}

    <section>
      <h2>Conocimientos</h2>
      <dl class="grid">
        {cv.skills.map((k) => (<><dt>{k.label}</dt><dd>{k.value}</dd></>))}
      </dl>
    </section>

    <section>
      <h2>Formación</h2>
      {cv.education.map((e) => (
        <div class="item">
          <div class="row"><span class="title">{e.title}</span><span class="meta">{e.period}</span></div>
          {e.place && <div class="sub">{e.place}</div>}
        </div>
      ))}
    </section>

    <section>
      <h2>Otros</h2>
      <dl class="grid">
        {cv.other.map((k) => (<><dt>{k.label}</dt><dd>{k.value}</dd></>))}
      </dl>
    </section>
  </main>
  <script is:inline>
    document.getElementById('print').addEventListener('click', function () { window.print(); });
    if (new URLSearchParams(location.search).has('print')) window.addEventListener('load', function () { window.print(); });
  </script>
</body>
</html>
